---
<nav class="fixed right-6 top-1/2 transform -translate-y-1/2 z-50 hidden md:flex flex-col gap-5 items-end select-none" id="directory-nav">
  <a href="#inicio" class="group flex items-center gap-3 cursor-pointer" data-target="inicio">
    <span class="text-[10px] uppercase tracking-[0.22em] text-white font-montserrat font-semibold nav-label">INICIO</span>
    <div class="w-2.5 h-2.5 rounded-full bg-sky-400 shadow-[0_0_12px_#38bdf8] ring-4 ring-sky-400/25 nav-dot"></div>
  </a>
  <a href="#por-que-nexus" class="group flex items-center gap-3 cursor-pointer" data-target="por-que-nexus">
    <span class="text-[10px] uppercase tracking-[0.22em] text-gray-400 group-hover:text-white transition-colors font-montserrat font-medium nav-label">NOSOTROS</span>
    <div class="w-2 h-2 rounded-full border border-white/40 bg-transparent transition-all group-hover:border-sky-400 group-hover:bg-sky-400 nav-dot"></div>
  </a>
  <a href="#servicios" class="group flex items-center gap-3 cursor-pointer" data-target="servicios">
    <span class="text-[10px] uppercase tracking-[0.22em] text-gray-400 group-hover:text-white transition-colors font-montserrat font-medium nav-label">SERVICIOS</span>
    <div class="w-2 h-2 rounded-full border border-white/40 bg-transparent transition-all group-hover:border-sky-400 group-hover:bg-sky-400 nav-dot"></div>
  </a>
  <a href="#tecnologia" class="group flex items-center gap-3 cursor-pointer" data-target="tecnologia">
    <span class="text-[10px] uppercase tracking-[0.22em] text-gray-400 group-hover:text-white transition-colors font-montserrat font-medium nav-label">TECNOLOGÍA</span>
    <div class="w-2 h-2 rounded-full border border-white/40 bg-transparent transition-all group-hover:border-sky-400 group-hover:border-sky-400 nav-dot"></div>
  </a>
  <a href="#paquetes" class="group flex items-center gap-3 cursor-pointer" data-target="paquetes">
    <span class="text-[10px] uppercase tracking-[0.22em] text-gray-400 group-hover:text-white transition-colors font-montserrat font-medium nav-label">SOLUCIONES</span>
    <div class="w-2 h-2 rounded-full border border-white/40 bg-transparent transition-all group-hover:border-sky-400 group-hover:border-sky-400 nav-dot"></div>
  </a>
  <a href="#contacto" class="group flex items-center gap-3 cursor-pointer" data-target="contacto">
    <span class="text-[10px] uppercase tracking-[0.22em] text-gray-400 group-hover:text-white transition-colors font-montserrat font-medium nav-label">CONTACTO</span>
    <div class="w-2 h-2 rounded-full border border-white/40 bg-transparent transition-all group-hover:border-sky-400 group-hover:border-sky-400 nav-dot"></div>
  </a>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('#directory-nav a');
    
    // Observer para resaltar la sección actual en el sidebar
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            const dot = link.querySelector('.nav-dot');
            const label = link.querySelector('.nav-label');
            
            if (link.getAttribute('href') === `#${id}`) {
              dot.className = 'w-2.5 h-2.5 rounded-full bg-sky-400 shadow-[0_0_12px_#38bdf8] ring-4 ring-sky-400/25 nav-dot';
              label.className = 'text-[10px] uppercase tracking-[0.22em] text-white font-montserrat font-semibold nav-label';
            } else {
              dot.className = 'w-2 h-2 rounded-full border border-white/40 bg-transparent transition-all group-hover:border-sky-400 group-hover:bg-sky-400 nav-dot';
              label.className = 'text-[10px] uppercase tracking-[0.22em] text-gray-400 group-hover:text-white transition-colors font-montserrat font-medium nav-label';
            }
          });
        }
      });
    }, {
      rootMargin: "-40% 0px -40% 0px"
    });

    sections.forEach(section => {
      observer.observe(section);
    });
  });
</script>
