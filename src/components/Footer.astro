---
---
<footer class="relative overflow-hidden bg-cosmos-dark border-t border-white/[0.08] z-20 text-white" id="contacto">
  <!-- Fondo Cósmico con Curvatura de la Tierra -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <img 
      src="/footer-earth-bg.jpg" 
      alt="Cosmos Earth Horizon" 
      class="w-full h-full object-cover object-bottom opacity-90" 
      loading="lazy"
    />
    <!-- Degradados para transición perfecta al fondo de la web -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#030712] via-[#030712]/80 to-[#030712]/30"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_transparent_30%,_rgba(3,7,18,0.7)_100%)]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-12 relative z-10">
    
    <!-- Grilla de 4 Columnas Principal -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 mb-16 sm:mb-20">
      
      <!-- Columna 1: Branding y Filosofía (lg:col-span-4) -->
      <div class="lg:col-span-4 flex flex-col items-start">
        <a href="/" class="flex items-center gap-3.5 group mb-5">
          <img 
            src="/logo-pegasus-new.png" 
            alt="Pegasus Nexus Logo" 
            class="h-11 sm:h-12 w-auto object-contain drop-shadow-[0_0_16px_rgba(56,189,248,0.8)] group-hover:scale-105 transition-transform" 
          />
          <div class="flex flex-col leading-tight">
            <span class="font-montserrat font-black text-lg sm:text-xl tracking-[0.16em] uppercase text-white">
              PEGASUS <span class="text-sky-400">NEXUS</span>
            </span>
            <span class="text-[8px] sm:text-[9px] text-gray-400 font-medium tracking-[0.24em] uppercase mt-0.5">
              IDEAS QUE CONECTAN REALIDADES
            </span>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-gray-300 font-montserrat font-light leading-relaxed mb-6 max-w-sm">
          Desarrollo de software comercial y aplicaciones web que elevan el cosmos de tu negocio con tecnología indestructible y veloz.
        </p>

        <!-- Destello de luz con estrella central -->
        <div class="relative w-28 h-px my-3">
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-sky-400 to-transparent"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-white rounded-full shadow-[0_0_8px_#38bdf8,0_0_14px_#38bdf8]"></div>
        </div>

        <div class="text-[9px] sm:text-[10px] font-mono tracking-[0.28em] text-gray-400 uppercase mt-2">
          UN MUNDO DE POSIBILIDADES
        </div>
      </div>

      <!-- Columna 2: Navegación (lg:col-span-2) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-mono font-bold tracking-[0.2em] text-white uppercase mb-2">
          NAVEGACIÓN
        </h4>
        <div class="w-8 h-[2px] bg-sky-400 mb-6"></div>
        <ul class="space-y-3 font-montserrat text-xs sm:text-sm text-gray-300">
          <li><a href="#inicio" class="hover:text-sky-400 transition-colors">Inicio</a></li>
          <li><a href="#servicios" class="hover:text-sky-400 transition-colors">Soluciones</a></li>
          <li><a href="#paquetes" class="hover:text-sky-400 transition-colors">Planes</a></li>
          <li><a href="#por-que-nexus" class="hover:text-sky-400 transition-colors">Sobre Nosotros</a></li>
          <li><a href="#contacto" class="hover:text-sky-400 transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Columna 3: Servicios Especializados (lg:col-span-3) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-mono font-bold tracking-[0.2em] text-white uppercase mb-2">
          SERVICIOS
        </h4>
        <div class="w-8 h-[2px] bg-sky-400 mb-6"></div>
        <ul class="space-y-3.5 font-montserrat text-xs sm:text-sm text-gray-300">
          <li>
            <a href="#servicios" class="flex items-center gap-3 hover:text-sky-300 transition-colors group">
              <svg class="w-4 h-4 text-sky-400 shrink-0 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
              <span>Seguridad (Tauro)</span>
            </a>
          </li>
          <li>
            <a href="#servicios" class="flex items-center gap-3 hover:text-sky-300 transition-colors group">
              <svg class="w-4 h-4 text-sky-400 shrink-0 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
                <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>
              </svg>
              <span>Backups (Fénix)</span>
            </a>
          </li>
          <li>
            <a href="#servicios" class="flex items-center gap-3 hover:text-sky-300 transition-colors group">
              <svg class="w-4 h-4 text-sky-400 shrink-0 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
              <span>Integraciones API (Andrómeda)</span>
            </a>
          </li>
          <li>
            <a href="#servicios" class="flex items-center gap-3 hover:text-sky-300 transition-colors group">
              <svg class="w-4 h-4 text-sky-400 shrink-0 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
              </svg>
              <span>SaaS (Pegaso)</span>
            </a>
          </li>
          <li>
            <a href="#paquetes" class="flex items-center gap-3 hover:text-sky-300 transition-colors group">
              <svg class="w-4 h-4 text-sky-400 shrink-0 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="7" height="7" x="3" y="3" rx="1"/>
                <rect width="7" height="7" x="14" y="3" rx="1"/>
                <rect width="7" height="7" x="14" y="14" rx="1"/>
                <rect width="7" height="7" x="3" y="14" rx="1"/>
              </svg>
              <span>Solución con Odoo</span>
              <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-[10px] font-bold text-white bg-[#714B67] shadow-[0_0_8px_rgba(113,75,103,0.6)] ml-1">
                odoo
              </span>
            </a>
          </li>
          <li>
            <a href="#servicios" class="flex items-center gap-3 hover:text-sky-300 transition-colors group">
              <svg class="w-4 h-4 text-sky-400 shrink-0 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m18 2 4 4"/>
                <path d="m17 7 3-3"/>
                <path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"/>
                <path d="m9 11 4 4"/>
                <path d="m5 19-3 3"/>
                <path d="m14 4 6 6"/>
              </svg>
              <span>Desarrollo a Medida</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacto Corporativo (lg:col-span-3) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-mono font-bold tracking-[0.2em] text-white uppercase mb-2">
          CONTACTO CORPORATIVO
        </h4>
        <div class="w-8 h-[2px] bg-sky-400 mb-6"></div>
        
        <p class="text-xs sm:text-sm text-gray-300 font-montserrat font-light leading-relaxed mb-4">
          ¿Listo para llevar tu empresa a otro nivel? Hablemos.
        </p>

        <!-- Botón Enviar Mensaje -->
        <a 
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20gustar%C3%ADa%20conversar%20sobre%20un%20proyecto."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between w-full px-4 py-2.5 mb-6 rounded-xl border border-sky-400/40 bg-sky-950/40 hover:bg-sky-500/20 hover:border-sky-400 text-white text-xs font-semibold tracking-wider transition-all shadow-[0_0_15px_rgba(14,165,233,0.2)] hover:shadow-[0_0_20px_rgba(56,189,248,0.5)] group cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-sky-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m22 2-7 20-4-9-9-4Z"/>
              <path d="M22 2 11 13"/>
            </svg>
            <span>Enviar Mensaje</span>
          </div>
          <span class="text-sm leading-none text-sky-400 group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <!-- Datos de contacto con iconos -->
        <ul class="space-y-3 font-montserrat text-xs text-gray-300">
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <a href="mailto:info@pegasus-nexus.com" class="hover:text-white transition-colors">info@pegasus-nexus.com</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href="https://wa.me/59179786916" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">+591 79786916</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="text-gray-300">Global · Remoto</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
              <path d="M2 12h20"/>
            </svg>
            <a href="https://pegasus-nexus.com" class="hover:text-white transition-colors">www.pegasus-nexus.com</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Separador Cósmico con Estrella Central -->
    <div class="relative w-full h-px mb-8">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-sky-400/50 to-transparent"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-white rounded-full shadow-[0_0_10px_#38bdf8,0_0_18px_#38bdf8]"></div>
    </div>

    <!-- Fila Inferior: Copyright, Lema y Redes Sociales -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <!-- Copyright -->
      <p class="text-xs text-gray-400 font-montserrat">
        &copy; {new Date().getFullYear()} Pegaso System. Todos los derechos reservados.
      </p>

      <!-- Lema Central con Líneas -->
      <div class="hidden lg:flex items-center gap-3 text-[10px] font-mono tracking-[0.25em] text-gray-400 uppercase">
        <div class="w-10 h-px bg-gradient-to-r from-transparent to-sky-400/60"></div>
        <span>INGENIERÍA DE SOFTWARE DE CLASE MUNDIAL</span>
        <div class="w-10 h-px bg-gradient-to-l from-transparent to-sky-400/60"></div>
      </div>

      <!-- Iconos de Redes Sociales -->
      <div class="flex items-center gap-3">
        <!-- LinkedIn -->
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/[0.03] border border-white/[0.08] hover:border-sky-400/60 hover:bg-sky-500/10 flex items-center justify-center text-gray-300 hover:text-sky-400 transition-all hover:shadow-[0_0_12px_rgba(56,189,248,0.3)]" aria-label="LinkedIn">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        </a>
        <!-- X (Twitter) -->
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/[0.03] border border-white/[0.08] hover:border-sky-400/60 hover:bg-sky-500/10 flex items-center justify-center text-gray-300 hover:text-sky-400 transition-all hover:shadow-[0_0_12px_rgba(56,189,248,0.3)]" aria-label="X (Twitter)">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <!-- YouTube -->
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/[0.03] border border-white/[0.08] hover:border-sky-400/60 hover:bg-sky-500/10 flex items-center justify-center text-gray-300 hover:text-sky-400 transition-all hover:shadow-[0_0_12px_rgba(56,189,248,0.3)]" aria-label="YouTube">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <!-- GitHub -->
        <a href="https://github.com/pegasus-nexus" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-white/[0.03] border border-white/[0.08] hover:border-sky-400/60 hover:bg-sky-500/10 flex items-center justify-center text-gray-300 hover:text-sky-400 transition-all hover:shadow-[0_0_12px_rgba(56,189,248,0.3)]" aria-label="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

