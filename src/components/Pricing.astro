---
---
<section id="planes" class="py-28 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
  <!-- Subtle continuous ambient glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(14,165,233,0.06),transparent)] pointer-events-none"></div>
  <div class="absolute bottom-0 inset-x-0 h-96 bg-[radial-gradient(ellipse_100%_50%_at_50%_120%,rgba(14,165,233,0.08),transparent)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado con nuestro estilo estándar unificado -->
    <div class="animate-on-scroll fade-in-up text-center max-w-4xl mx-auto mb-14">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="w-8 sm:w-12 h-px bg-gradient-to-r from-transparent to-sky-400"></div>
        <span class="text-sky-400 text-[10px] sm:text-xs font-bold tracking-[0.25em] uppercase text-glow">NUESTROS PLANOS DE SOLUCIÓN</span>
        <div class="w-8 sm:w-12 h-px bg-gradient-to-l from-transparent to-sky-400"></div>
      </div>
      
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-normal font-heading text-white tracking-wide mb-5">
        Arquitecturas digitales <br/>
        <span class="italic text-sky-400">para cada etapa de tu crecimiento</span>
      </h2>
      
      <p class="text-gray-300 text-xs sm:text-sm md:text-base font-light max-w-2xl mx-auto leading-relaxed">
        Soluciones flexibles y personalizables que se adaptan a tus objetivos, desde una presencia digital hasta ecosistemas empresariales completos.
      </p>
    </div>

    <!-- Selector Mensual / Anual -->
    <div class="animate-on-scroll fade-in-up flex items-center justify-center gap-3 mb-12">
      <div class="inline-flex p-1 rounded-full bg-[#0a1528]/80 border border-sky-500/25 backdrop-blur-md">
        <button
          id="billing-monthly-btn"
          type="button"
          class="px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-white bg-sky-500/20 border border-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] cursor-pointer"
        >
          Pago Mensual
        </button>
        <button
          id="billing-annual-btn"
          type="button"
          class="px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-gray-400 hover:text-white border border-transparent cursor-pointer flex items-center gap-2"
        >
          <span>Pago Anual</span>
          <span class="text-[10px] text-sky-300 bg-sky-500/20 px-2 py-0.5 rounded-full border border-sky-400/30 font-bold">Ahorra ~20%</span>
        </button>
      </div>
    </div>

    <!-- Grilla de los 3 Planes (Versión Simplificada para Portada) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch mb-10 max-w-6xl mx-auto">
      
      <!-- 01. PLAN GRATIS -->
      <div class="animate-on-scroll fade-in-up group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c]/80 border border-sky-500/20 backdrop-blur-md transition-all duration-500 hover:border-sky-400/50 hover:shadow-[0_15px_35px_rgba(14,165,233,0.18)] hover:-translate-y-1.5">
        <div>
          <!-- Icono & Tag de Plan -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 group-hover:border-sky-400 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.3)] transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
            </div>
            <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-gray-400 group-hover:text-sky-400 transition-colors">
              INICIAL
            </span>
          </div>

          <h3 class="text-white font-heading font-semibold text-2xl mb-2 group-hover:text-sky-300 transition-colors">
            Plan Gratis
          </h3>

          <p class="text-gray-300 text-sm font-light mb-8 leading-relaxed">
            Para explorar una solución básica.
          </p>

          <!-- Bloque de Precio -->
          <div class="mb-8">
            <div class="flex items-baseline gap-1.5 mb-2.5">
              <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight">$0</span>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px] font-medium">
              <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Gratis por 30 días</span>
            </div>
          </div>
        </div>

        <!-- Botón Quiero Empezar Ahora -->
        <a 
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Quiero%20empezar%20ahora%20con%20el%20Plan%20Gratis." 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-3.5 px-4 rounded-xl border border-sky-500/30 text-sky-300 hover:text-white hover:bg-sky-500/20 hover:border-sky-400 transition-all text-center text-xs font-bold tracking-[0.14em] uppercase flex items-center justify-center gap-2 group-hover:border-sky-400 cursor-pointer"
        >
          <span>QUIERO EMPEZAR AHORA</span>
          <span class="text-sm">→</span>
        </a>
      </div>

      <!-- 02. PLAN ESTÁNDAR (DESTACADO / RECOMENDADO) -->
      <div class="animate-on-scroll fade-in-up group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c] border-2 border-sky-400 shadow-[0_0_35px_rgba(14,165,233,0.25)] backdrop-blur-md transition-all duration-500 hover:shadow-[0_0_50px_rgba(56,189,248,0.35)] hover:-translate-y-2" style="animation-delay: 100ms;">
        <!-- Glow ambiental superior -->
        <div class="absolute -top-10 -right-10 w-44 h-44 bg-sky-500/20 blur-3xl rounded-full pointer-events-none"></div>

        <div>
          <!-- Icono, Tag de Plan y Badge "MÁS ELEGIDO" -->
          <div class="flex items-center justify-between gap-2 mb-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-sky-500/20 border border-sky-400 flex items-center justify-center text-sky-300 shadow-[0_0_15px_rgba(56,189,248,0.4)]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
              </div>
              <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-sky-400">
                RECOMENDADO
              </span>
            </div>

            <!-- Badge Más Elegido -->
            <span class="px-2.5 py-1 rounded-full bg-sky-500/20 border border-sky-400 text-sky-300 text-[9px] font-bold uppercase tracking-wider shadow-[0_0_10px_rgba(56,189,248,0.3)]">
              MÁS ELEGIDO
            </span>
          </div>

          <h3 class="text-white font-heading font-semibold text-2xl mb-2 text-glow">
            Plan Estándar
          </h3>

          <p class="text-gray-300 text-sm font-light mb-8 leading-relaxed">
            Para gestionar operaciones del negocio.
          </p>

          <!-- Bloque de Precio -->
          <div class="mb-8">
            <div class="flex items-baseline gap-1.5 mb-2.5">
              <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight price-monthly">$8.15</span>
              <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight price-annual hidden">$6.52</span>
              <span class="text-xs text-gray-400 font-light billing-cycle-text">USD / mes</span>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/20 border border-sky-400/40 text-sky-300 text-[11px] font-medium shadow-[0_0_12px_rgba(56,189,248,0.25)]">
              <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Gratis por 15 días</span>
            </div>
          </div>
        </div>

        <!-- Botón Quiero Empezar Ahora -->
        <a 
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Quiero%20empezar%20ahora%20con%20el%20Plan%20Est%C3%A1ndar." 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-xs tracking-[0.14em] uppercase shadow-[0_0_25px_rgba(14,165,233,0.7)] hover:shadow-[0_0_35px_rgba(56,189,248,0.9)] transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>QUIERO EMPEZAR AHORA</span>
          <span class="text-sm">→</span>
        </a>
      </div>

      <!-- 03. PLAN PERSONALIZADO -->
      <div class="animate-on-scroll fade-in-up group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c]/80 border border-sky-500/20 backdrop-blur-md transition-all duration-500 hover:border-sky-400/50 hover:shadow-[0_15px_35px_rgba(14,165,233,0.18)] hover:-translate-y-1.5" style="animation-delay: 200ms;">
        <div>
          <!-- Icono & Tag de Plan -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 group-hover:border-sky-400 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.3)] transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </div>
            <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-gray-400 group-hover:text-sky-400 transition-colors">
              A MEDIDA
            </span>
          </div>

          <h3 class="text-white font-heading font-semibold text-2xl mb-2 group-hover:text-sky-300 transition-colors">
            Plan Personalizado
          </h3>

          <p class="text-gray-300 text-sm font-light mb-8 leading-relaxed">
            Para necesidades empresariales específicas.
          </p>

          <!-- Bloque de Precio -->
          <div class="mb-8">
            <div class="flex items-baseline gap-1.5 mb-2.5">
              <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight price-monthly">$15.10</span>
              <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight price-annual hidden">$12.38</span>
              <span class="text-xs text-gray-400 font-light billing-cycle-text">USD / mes</span>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/15 border border-sky-400/40 text-sky-300 text-[11px] font-medium">
              <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Gratis por 15 días</span>
            </div>
          </div>
        </div>

        <!-- Botón Quiero Empezar Ahora -->
        <a 
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Quiero%20empezar%20ahora%20con%20el%20Plan%20Personalizado." 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-3.5 px-4 rounded-xl border border-sky-500/30 text-sky-300 hover:text-white hover:bg-sky-500/20 hover:border-sky-400 transition-all text-center text-xs font-bold tracking-[0.14em] uppercase flex items-center justify-center gap-2 group-hover:border-sky-400 cursor-pointer"
        >
          <span>QUIERO EMPEZAR AHORA</span>
          <span class="text-sm">→</span>
        </a>
      </div>

    </div>

    <!-- Nota de Referencia de Precios -->
    <p class="text-center text-xs text-gray-400 font-light max-w-2xl mx-auto mb-10 leading-relaxed px-4">
      Precios de referencia según el contenido actual. Deben aclararse condiciones, alcance, impuestos y precio por usuario, si corresponde.
    </p>

    <!-- Enlace a la vista ampliada de planes -->
    <div class="text-center mt-2 mb-8">
      <a
        href="/planes"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-sky-400/40 bg-sky-950/30 hover:bg-sky-500/20 text-sky-300 hover:text-white text-xs font-semibold tracking-wider uppercase transition-all shadow-[0_0_15px_rgba(14,165,233,0.2)] hover:shadow-[0_0_25px_rgba(56,189,248,0.5)] cursor-pointer"
      >
        <span>Ver vista ampliada de planes y servicios</span>
        <span class="text-sm">→</span>
      </a>
    </div>

    <!-- Script interactivo para alternar facturación mensual/anual -->
    <script is:inline>
      function setupPricingToggle() {
        const monthlyBtn = document.getElementById('billing-monthly-btn');
        const annualBtn = document.getElementById('billing-annual-btn');
        const monthlyPrices = document.querySelectorAll('.price-monthly');
        const annualPrices = document.querySelectorAll('.price-annual');
        const billingCycles = document.querySelectorAll('.billing-cycle-text');

        if (!monthlyBtn || !annualBtn) return;

        function setBilling(isAnnual) {
          if (isAnnual) {
            monthlyBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-gray-400 hover:text-white border border-transparent cursor-pointer';
            annualBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-white bg-sky-500/20 border border-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] cursor-pointer flex items-center gap-2';

            monthlyPrices.forEach((el) => el.classList.add('hidden'));
            annualPrices.forEach((el) => el.classList.remove('hidden'));
            billingCycles.forEach((el) => (el.textContent = 'USD / mes (anual)'));
          } else {
            annualBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-gray-400 hover:text-white border border-transparent cursor-pointer flex items-center gap-2';
            monthlyBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-white bg-sky-500/20 border border-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] cursor-pointer';

            annualPrices.forEach((el) => el.classList.add('hidden'));
            monthlyPrices.forEach((el) => el.classList.remove('hidden'));
            billingCycles.forEach((el) => (el.textContent = 'USD / mes'));
          }
        }

        monthlyBtn.onclick = () => setBilling(false);
        annualBtn.onclick = () => setBilling(true);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupPricingToggle);
      } else {
        setupPricingToggle();
      }
      document.addEventListener('astro:page-load', setupPricingToggle);
    </script>

  </div>
</section>
