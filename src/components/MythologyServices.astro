---
---
<section id="servicios" class="py-28 bg-cosmos-dark relative z-10 overflow-hidden border-t border-white/[0.05]">
  <!-- Subtle continuous ambient background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(14,165,233,0.07),transparent)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_100%,rgba(56,189,248,0.04),transparent)] pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado Central -->
    <div class="animate-on-scroll fade-in-up text-center max-w-3xl mx-auto mb-20">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="w-8 sm:w-12 h-px bg-gradient-to-r from-transparent to-sky-400"></div>
        <span class="text-sky-400 text-[10px] sm:text-xs font-bold tracking-[0.25em] uppercase text-glow">SOLUCIONES ESPECIALIZADAS</span>
        <div class="w-8 sm:w-12 h-px bg-gradient-to-l from-transparent to-sky-400"></div>
      </div>
      
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-normal font-heading text-white tracking-wide mb-5">
        Arquitectura Digital <span class="italic text-sky-400">Pegasus</span>
      </h2>
      
      <p class="text-white text-base sm:text-lg font-medium mb-2">
        Cinco pilares. Un mismo propósito.
      </p>
      <p class="text-gray-400 text-xs sm:text-sm font-light max-w-2xl mx-auto leading-relaxed">
        Soluciones que trabajan en conjunto para una empresa más segura, eficiente y preparada para el futuro.
      </p>
    </div>

    <!-- Grilla de las 5 Tarjetas / Pilares Cósmicos (Más Grandes y Espaciosas) -->
    <div class="relative max-w-7xl mx-auto">
      
      <!-- Línea conectora cósmica sutil por detrás de las esferas (visible en pantallas grandes) -->
      <div class="hidden lg:block absolute top-[64px] left-[6%] right-[6%] h-[1px] bg-gradient-to-r from-transparent via-sky-500/25 to-transparent pointer-events-none -z-0"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 sm:gap-6 lg:gap-5 items-stretch">
        
        <!-- 01. TAURO -->
        <div class="animate-on-scroll fade-in-up group relative flex flex-col pt-16">
          <!-- Esfera de Icono Cósmico superior centrada y flotante más grande -->
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-20 transition-transform duration-500 group-hover:scale-110">
            <div class="w-28 h-28 rounded-full p-1 relative flex items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-sky-500/25 blur-xl group-hover:bg-sky-400/50 transition-colors"></div>
              <img src="/solucion-tauro.png" alt="Tauro - Seguridad y Fortaleza Digital" class="w-24 h-24 object-contain relative z-10 drop-shadow-[0_0_20px_rgba(56,189,248,0.6)]" />
            </div>
          </div>

          <!-- Tarjeta de Contenido Agrandada -->
          <div class="flex-1 pt-16 pb-10 px-6 rounded-3xl bg-[#081020]/80 border border-sky-500/25 backdrop-blur-md flex flex-col items-center text-center transition-all duration-500 group-hover:border-sky-400/60 group-hover:shadow-[0_15px_35px_rgba(14,165,233,0.2)] group-hover:-translate-y-1.5 relative overflow-hidden">
            <!-- Indicador Numérico -->
            <span class="absolute top-5 right-5 text-xs font-mono font-bold text-gray-500/60 group-hover:text-sky-400 transition-colors">01</span>

            <h3 class="text-white font-montserrat font-extrabold text-base tracking-[0.2em] uppercase mt-2 mb-2">
              TAURO
            </h3>
            
            <h4 class="text-sky-400 font-semibold text-sm tracking-wide leading-snug mb-5 min-h-[40px] flex items-center justify-center">
              Seguridad y<br/>Fortaleza Digital
            </h4>

            <p class="text-gray-300 text-xs sm:text-[13px] font-light leading-relaxed">
              Protegemos tu <strong class="text-white font-medium">información</strong> con arquitecturas seguras, monitoreo continuo y ciberseguridad de alto nivel.
            </p>
          </div>
        </div>

        <!-- 02. FÉNIX -->
        <div class="animate-on-scroll fade-in-up group relative flex flex-col pt-16" style="animation-delay: 100ms;">
          <!-- Esfera de Icono Cósmico superior centrada y flotante más grande -->
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-20 transition-transform duration-500 group-hover:scale-110">
            <div class="w-28 h-28 rounded-full p-1 relative flex items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-orange-500/25 blur-xl group-hover:bg-orange-400/50 transition-colors"></div>
              <img src="/solucion-fenix.png" alt="Fénix - Resiliencia y Continuidad" class="w-24 h-24 object-contain relative z-10 drop-shadow-[0_0_20px_rgba(249,115,22,0.6)]" />
            </div>
          </div>

          <!-- Tarjeta de Contenido Agrandada -->
          <div class="flex-1 pt-16 pb-10 px-6 rounded-3xl bg-[#081020]/80 border border-orange-500/25 backdrop-blur-md flex flex-col items-center text-center transition-all duration-500 group-hover:border-orange-400/60 group-hover:shadow-[0_15px_35px_rgba(249,115,22,0.2)] group-hover:-translate-y-1.5 relative overflow-hidden">
            <!-- Indicador Numérico -->
            <span class="absolute top-5 right-5 text-xs font-mono font-bold text-gray-500/60 group-hover:text-orange-400 transition-colors">02</span>

            <h3 class="text-white font-montserrat font-extrabold text-base tracking-[0.2em] uppercase mt-2 mb-2">
              FÉNIX
            </h3>
            
            <h4 class="text-orange-400 font-semibold text-sm tracking-wide leading-snug mb-5 min-h-[40px] flex items-center justify-center">
              Resiliencia y<br/>Continuidad Operativa
            </h4>

            <p class="text-gray-300 text-xs sm:text-[13px] font-light leading-relaxed">
              Tu <strong class="text-white font-medium">negocio siempre activo</strong>. Backups, recuperación y alta disponibilidad ante cualquier escenario.
            </p>
          </div>
        </div>

        <!-- 03. ARIES -->
        <div class="animate-on-scroll fade-in-up group relative flex flex-col pt-16" style="animation-delay: 200ms;">
          <!-- Esfera de Icono Cósmico superior centrada y flotante más grande -->
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-20 transition-transform duration-500 group-hover:scale-110">
            <div class="w-28 h-28 rounded-full p-1 relative flex items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-teal-500/25 blur-xl group-hover:bg-teal-400/50 transition-colors"></div>
              <img src="/solucion-aries.png" alt="Aries - Mantenimiento y Soporte Especializado" class="w-24 h-24 object-contain relative z-10 drop-shadow-[0_0_20px_rgba(20,184,166,0.6)]" />
            </div>
          </div>

          <!-- Tarjeta de Contenido Agrandada -->
          <div class="flex-1 pt-16 pb-10 px-6 rounded-3xl bg-[#081020]/80 border border-teal-500/25 backdrop-blur-md flex flex-col items-center text-center transition-all duration-500 group-hover:border-teal-400/60 group-hover:shadow-[0_15px_35px_rgba(20,184,166,0.2)] group-hover:-translate-y-1.5 relative overflow-hidden">
            <!-- Indicador Numérico -->
            <span class="absolute top-5 right-5 text-xs font-mono font-bold text-gray-500/60 group-hover:text-teal-400 transition-colors">03</span>

            <h3 class="text-white font-montserrat font-extrabold text-base tracking-[0.2em] uppercase mt-2 mb-2">
              ARIES
            </h3>
            
            <h4 class="text-teal-400 font-semibold text-sm tracking-wide leading-snug mb-5 min-h-[40px] flex items-center justify-center">
              Mantenimiento y<br/>Soporte Especializado
            </h4>

            <p class="text-gray-300 text-xs sm:text-[13px] font-light leading-relaxed">
              Garantizamos <strong class="text-white font-medium">el rendimiento</strong> de tus sistemas con soporte continuo y optimización constante.
            </p>
          </div>
        </div>

        <!-- 04. ANDRÓMEDA -->
        <div class="animate-on-scroll fade-in-up group relative flex flex-col pt-16" style="animation-delay: 300ms;">
          <!-- Esfera de Icono Cósmico superior centrada y flotante más grande -->
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-20 transition-transform duration-500 group-hover:scale-110">
            <div class="w-28 h-28 rounded-full p-1 relative flex items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-purple-500/25 blur-xl group-hover:bg-purple-400/50 transition-colors"></div>
              <img src="/solucion-andromeda.png" alt="Andrómeda - Integración de Sistemas" class="w-24 h-24 object-contain relative z-10 drop-shadow-[0_0_20px_rgba(168,85,247,0.6)]" />
            </div>
          </div>

          <!-- Tarjeta de Contenido Agrandada -->
          <div class="flex-1 pt-16 pb-10 px-6 rounded-3xl bg-[#081020]/80 border border-purple-500/25 backdrop-blur-md flex flex-col items-center text-center transition-all duration-500 group-hover:border-purple-400/60 group-hover:shadow-[0_15px_35px_rgba(168,85,247,0.2)] group-hover:-translate-y-1.5 relative overflow-hidden">
            <!-- Indicador Numérico -->
            <span class="absolute top-5 right-5 text-xs font-mono font-bold text-gray-500/60 group-hover:text-purple-400 transition-colors">04</span>

            <h3 class="text-white font-montserrat font-extrabold text-base tracking-[0.2em] uppercase mt-2 mb-2">
              ANDRÓMEDA
            </h3>
            
            <h4 class="text-purple-400 font-semibold text-sm tracking-wide leading-snug mb-5 min-h-[40px] flex items-center justify-center">
              Integración e<br/>Interconectividad
            </h4>

            <p class="text-gray-300 text-xs sm:text-[13px] font-light leading-relaxed">
              Conectamos tus <strong class="text-white font-medium">plataformas y datos</strong> a través de APIs, microservicios e integraciones seguras.
            </p>
          </div>
        </div>

        <!-- 05. PEGASO -->
        <div class="animate-on-scroll fade-in-up group relative flex flex-col pt-16" style="animation-delay: 400ms;">
          <!-- Esfera de Icono Cósmico superior centrada y flotante más grande -->
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-20 transition-transform duration-500 group-hover:scale-110">
            <div class="w-28 h-28 rounded-full p-1 relative flex items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-amber-400/25 blur-xl group-hover:bg-amber-300/50 transition-colors"></div>
              <img src="/solucion-pegaso.png" alt="Pegaso - Soluciones SaaS" class="w-24 h-24 object-contain relative z-10 drop-shadow-[0_0_20px_rgba(245,158,11,0.6)]" />
            </div>
          </div>

          <!-- Tarjeta de Contenido Agrandada -->
          <div class="flex-1 pt-16 pb-10 px-6 rounded-3xl bg-[#081020]/80 border border-amber-500/25 backdrop-blur-md flex flex-col items-center text-center transition-all duration-500 group-hover:border-amber-400/60 group-hover:shadow-[0_15px_35px_rgba(245,158,11,0.2)] group-hover:-translate-y-1.5 relative overflow-hidden">
            <!-- Indicador Numérico -->
            <span class="absolute top-5 right-5 text-xs font-mono font-bold text-gray-500/60 group-hover:text-amber-400 transition-colors">05</span>

            <h3 class="text-white font-montserrat font-extrabold text-base tracking-[0.2em] uppercase mt-2 mb-2">
              PEGASO
            </h3>
            
            <h4 class="text-amber-400 font-semibold text-sm tracking-wide leading-snug mb-5 min-h-[40px] flex items-center justify-center">
              Soluciones SaaS<br/>de Alta Escalabilidad
            </h4>

            <p class="text-gray-300 text-xs sm:text-[13px] font-light leading-relaxed">
              Desarrollamos <strong class="text-white font-medium">plataformas ágiles</strong>, robustas y preparadas para crecer sin límites.
            </p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
