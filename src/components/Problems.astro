---
---

<section id="desafios" class="pt-28 pb-20 relative overflow-hidden z-20" style="background-color: #131726;">
  
  <!-- Subtle ambient glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/3 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-sky-600/[0.05] blur-[140px] rounded-full"></div>
    <div class="absolute bottom-10 right-10 w-[500px] h-[350px] bg-blue-600/[0.04] blur-[120px] rounded-full"></div>
  </div>

  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Split Layout Grid: Left Header & Odoo, Right 3x2 Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-14 items-start">
      
      <!-- Left Column: Header, Description, Odoo Partner, and CTA Buttons -->
      <div class="lg:col-span-4 flex flex-col items-center lg:items-start text-center lg:text-left select-none">
        
        <!-- Category Top Badge -->
        <div class="flex items-center gap-3 mb-5 select-none">
          <div class="w-8 sm:w-10 h-[2px] bg-sky-400"></div>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.25em] uppercase text-sky-400 font-montserrat">
            PROBLEMAS QUE RESOLVEMOS
          </span>
        </div>

        <!-- Main Heading -->
        <h3 class="text-3xl sm:text-4xl xl:text-5xl font-normal font-heading mb-6 text-white tracking-normal leading-[1.12]">
          ¿Tu empresa<br class="hidden sm:inline" /> enfrenta alguno<br class="hidden sm:inline" /> de estos <span class="italic text-sky-400 font-serif font-normal">desafíos?</span>
        </h3>

        <!-- Description Paragraph -->
        <p class="text-gray-300 font-montserrat font-light text-xs sm:text-sm leading-relaxed mb-8 max-w-md">
          Las ineficiencias operativas y la falta de datos claros frenan el crecimiento. En Pegasus Nexus transformamos estos obstáculos en flujos digitales automatizados y listos para la toma de decisiones.
        </p>

        <!-- Partner Odoo Card -->
        <div class="w-full max-w-md rounded-2xl bg-[#0a0f1d]/85 border border-sky-500/20 p-5 mb-8 backdrop-blur-md shadow-[0_6px_25px_rgba(0,0,0,0.35)] text-left">
          <span class="text-[9px] tracking-[0.25em] text-sky-400/90 uppercase font-mono font-semibold block mb-3">
            PARTNER TECNOLÓGICO
          </span>
          
          <div class="flex items-center gap-4 mb-3">
            <img 
              src="/logo-odoo.png" 
              alt="Odoo Partner Tecnológico" 
              class="h-7 sm:h-8 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(169,76,146,0.6)] shrink-0" 
            />
            <div class="w-px h-7 bg-white/20"></div>
            <p class="text-[11px] sm:text-xs text-gray-300 font-light leading-snug">
              Implementación, personalización y soporte empresarial.
            </p>
          </div>

          <div class="pt-3 border-t border-white/[0.08]">
            <span class="text-[8.5px] sm:text-[9px] tracking-[0.18em] text-gray-400 uppercase font-mono block">
              MÁS QUE UN ERP, UN ALIADO PARA TU CRECIMIENTO
            </span>
          </div>
        </div>

        <!-- CTA Buttons Row -->
        <div class="w-full max-w-md flex flex-col sm:flex-row items-center gap-4 mb-2 justify-center lg:justify-start">
          <a
            href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20gustar%C3%ADa%20solicitar%20un%20diagn%C3%B3stico%20gratuito%20para%20mi%20empresa."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto text-center bg-gradient-to-r from-blue-600 via-sky-500 to-blue-600 hover:from-blue-500 hover:to-sky-400 text-white font-bold py-3.5 px-6 rounded-xl transition-all text-[10px] sm:text-[11px] tracking-wider uppercase shadow-[0_0_20px_rgba(56,189,248,0.35)] hover:shadow-[0_0_30px_rgba(56,189,248,0.6)] hover:scale-105 transform cursor-pointer flex items-center justify-center gap-2 shrink-0"
          >
            <span>SOLICITAR DIAGNÓSTICO GRATUITO</span>
            <span class="text-sm">→</span>
          </a>
          
          <a
            href="#soluciones"
            class="text-sky-400 hover:text-sky-300 text-xs font-montserrat underline underline-offset-4 tracking-wide transition-colors whitespace-nowrap"
          >
            Ver soluciones
          </a>
        </div>

        <!-- Subtext -->
        <span class="text-[10px] text-gray-400 font-montserrat font-light mt-1 block">
          Sin compromisos · Diagnóstico 100% gratuito
        </span>

      </div>

      <!-- Right Column: 6 Cards in 3x2 Grid -->
      <div class="lg:col-span-8 flex flex-col justify-between">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-5">
          
          <!-- Card 1: Archivos Excel -->
          <div class="group rounded-2xl p-6 bg-[#0a0f1d]/85 border border-white/[0.06] hover:border-sky-500/40 hover:bg-[#0e162b]/90 transition-all duration-500 flex flex-col justify-between shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:shadow-[0_8px_30px_rgba(14,165,233,0.18)] backdrop-blur-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-sky-950/60 border border-sky-500/30 flex items-center justify-center mb-5 shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:border-sky-400/60 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2Z" fill="#0284c7" fill-opacity="0.25" stroke="#38bdf8" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M14 2V8H20" stroke="#38bdf8" stroke-width="1.8" stroke-linejoin="round"/>
                  <rect x="7" y="11" width="8" height="8" rx="1.5" fill="#0284c7" stroke="#38bdf8" stroke-width="1.2"/>
                  <path d="M9 13L13 17M13 13L9 17" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </div>
              <h4 class="text-lg sm:text-xl font-heading font-semibold text-white mb-2 group-hover:text-sky-300 transition-colors">
                Archivos Excel
              </h4>
              <p class="text-gray-400 font-montserrat font-light text-xs leading-relaxed mb-6">
                Información fragmentada y duplicada en múltiples planillas y formatos incompatibles.
              </p>
            </div>
            <div class="w-6 h-[2px] bg-sky-400/80 rounded-full group-hover:w-12 group-hover:bg-sky-300 transition-all duration-300 shadow-[0_0_8px_rgba(56,189,248,0.7)]"></div>
          </div>

          <!-- Card 2: Tareas Manuales -->
          <div class="group rounded-2xl p-6 bg-[#0a0f1d]/85 border border-white/[0.06] hover:border-sky-500/40 hover:bg-[#0e162b]/90 transition-all duration-500 flex flex-col justify-between shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:shadow-[0_8px_30px_rgba(14,165,233,0.18)] backdrop-blur-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-sky-950/60 border border-sky-500/30 flex items-center justify-center mb-5 shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:border-sky-400/60 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all">
                <svg class="w-6 h-6 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" fill="#0284c7" fill-opacity="0.25" stroke="#38bdf8"/>
                  <path d="M12 7V12L15.5 14" stroke="#38bdf8" stroke-width="2"/>
                  <path d="M12 3V5" stroke="#38bdf8" stroke-width="1.5"/>
                  <path d="M21 12H19" stroke="#38bdf8" stroke-width="1.5"/>
                  <path d="M12 21V19" stroke="#38bdf8" stroke-width="1.5"/>
                  <path d="M3 12H5" stroke="#38bdf8" stroke-width="1.5"/>
                </svg>
              </div>
              <h4 class="text-lg sm:text-xl font-heading font-semibold text-white mb-2 group-hover:text-sky-300 transition-colors">
                Tareas Manuales
              </h4>
              <p class="text-gray-400 font-montserrat font-light text-xs leading-relaxed mb-6">
                Operaciones repetitivas del día a día que consumen tiempo valioso y causan errores.
              </p>
            </div>
            <div class="w-6 h-[2px] bg-sky-400/80 rounded-full group-hover:w-12 group-hover:bg-sky-300 transition-all duration-300 shadow-[0_0_8px_rgba(56,189,248,0.7)]"></div>
          </div>

          <!-- Card 3: Falta de KPIs -->
          <div class="group rounded-2xl p-6 bg-[#0a0f1d]/85 border border-white/[0.06] hover:border-sky-500/40 hover:bg-[#0e162b]/90 transition-all duration-500 flex flex-col justify-between shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:shadow-[0_8px_30px_rgba(14,165,233,0.18)] backdrop-blur-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-sky-950/60 border border-sky-500/30 flex items-center justify-center mb-5 shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:border-sky-400/60 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="4" y="14" width="4" height="6" rx="1" fill="#38bdf8" fill-opacity="0.4" stroke="#38bdf8" stroke-width="1.6"/>
                  <rect x="10" y="9" width="4" height="11" rx="1" fill="#38bdf8" fill-opacity="0.7" stroke="#38bdf8" stroke-width="1.6"/>
                  <rect x="16" y="4" width="4" height="16" rx="1" fill="#38bdf8" stroke="#7dd3fc" stroke-width="1.6"/>
                </svg>
              </div>
              <h4 class="text-lg sm:text-xl font-heading font-semibold text-white mb-2 group-hover:text-sky-300 transition-colors">
                Falta de KPIs
              </h4>
              <p class="text-gray-400 font-montserrat font-light text-xs leading-relaxed mb-6">
                Ausencia de indicadores claros en tiempo real para tomar decisiones de negocio seguras.
              </p>
            </div>
            <div class="w-6 h-[2px] bg-sky-400/80 rounded-full group-hover:w-12 group-hover:bg-sky-300 transition-all duration-300 shadow-[0_0_8px_rgba(56,189,248,0.7)]"></div>
          </div>

          <!-- Card 4: Ventas y Stock -->
          <div class="group rounded-2xl p-6 bg-[#0a0f1d]/85 border border-white/[0.06] hover:border-sky-500/40 hover:bg-[#0e162b]/90 transition-all duration-500 flex flex-col justify-between shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:shadow-[0_8px_30px_rgba(14,165,233,0.18)] backdrop-blur-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-sky-950/60 border border-sky-500/30 flex items-center justify-center mb-5 shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:border-sky-400/60 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L3 7V17L12 22L21 17V7L12 2Z" fill="#0284c7" fill-opacity="0.25" stroke="#38bdf8" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M12 22V12" stroke="#38bdf8" stroke-width="1.8"/>
                  <path d="M21 7L12 12L3 7" stroke="#38bdf8" stroke-width="1.8"/>
                  <path d="M7.5 4.5L16.5 9.5" stroke="#7dd3fc" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              </div>
              <h4 class="text-lg sm:text-xl font-heading font-semibold text-white mb-2 group-hover:text-sky-300 transition-colors">
                Ventas y Stock
              </h4>
              <p class="text-gray-400 font-montserrat font-light text-xs leading-relaxed mb-6">
                Dificultad para controlar existencias y conciliar los flujos de ventas diarias.
              </p>
            </div>
            <div class="w-6 h-[2px] bg-sky-400/80 rounded-full group-hover:w-12 group-hover:bg-sky-300 transition-all duration-300 shadow-[0_0_8px_rgba(56,189,248,0.7)]"></div>
          </div>

          <!-- Card 5: Áreas Aisladas -->
          <div class="group rounded-2xl p-6 bg-[#0a0f1d]/85 border border-white/[0.06] hover:border-sky-500/40 hover:bg-[#0e162b]/90 transition-all duration-500 flex flex-col justify-between shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:shadow-[0_8px_30px_rgba(14,165,233,0.18)] backdrop-blur-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-sky-950/60 border border-sky-500/30 flex items-center justify-center mb-5 shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:border-sky-400/60 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="6" cy="9" r="3" fill="#0284c7" fill-opacity="0.4" stroke="#38bdf8" stroke-width="1.8"/>
                  <circle cx="18" cy="9" r="3" fill="#0284c7" fill-opacity="0.4" stroke="#38bdf8" stroke-width="1.8"/>
                  <circle cx="12" cy="18" r="3" fill="#0284c7" fill-opacity="0.4" stroke="#38bdf8" stroke-width="1.8"/>
                  <path d="M8.5 10.5L10.5 15.5" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="2 2"/>
                  <path d="M15.5 10.5L13.5 15.5" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="2 2"/>
                  <path d="M9 9H15" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="2 2"/>
                </svg>
              </div>
              <h4 class="text-lg sm:text-xl font-heading font-semibold text-white mb-2 group-hover:text-sky-300 transition-colors">
                Áreas Aisladas
              </h4>
              <p class="text-gray-400 font-montserrat font-light text-xs leading-relaxed mb-6">
                Desconexión y falta de flujo integrado de información entre los departamentos.
              </p>
            </div>
            <div class="w-6 h-[2px] bg-sky-400/80 rounded-full group-hover:w-12 group-hover:bg-sky-300 transition-all duration-300 shadow-[0_0_8px_rgba(56,189,248,0.7)]"></div>
          </div>

          <!-- Card 6: Poca Visibilidad -->
          <div class="group rounded-2xl p-6 bg-[#0a0f1d]/85 border border-white/[0.06] hover:border-sky-500/40 hover:bg-[#0e162b]/90 transition-all duration-500 flex flex-col justify-between shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:shadow-[0_8px_30px_rgba(14,165,233,0.18)] backdrop-blur-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-sky-950/60 border border-sky-500/30 flex items-center justify-center mb-5 shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:border-sky-400/60 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 12C2 12 5.5 5 12 5C18.5 5 22 12 22 12C22 12 18.5 19 12 19C5.5 19 2 12 2 12Z" fill="#0284c7" fill-opacity="0.25" stroke="#38bdf8" stroke-width="1.8" stroke-linejoin="round"/>
                  <circle cx="12" cy="12" r="3.5" fill="#38bdf8" stroke="#e0f2fe" stroke-width="1.5"/>
                  <circle cx="13" cy="11" r="1" fill="white"/>
                </svg>
              </div>
              <h4 class="text-lg sm:text-xl font-heading font-semibold text-white mb-2 group-hover:text-sky-300 transition-colors">
                Poca Visibilidad
              </h4>
              <p class="text-gray-400 font-montserrat font-light text-xs leading-relaxed mb-6">
                Dificultad para visualizar el estado del negocio de manera oportuna y consolidada.
              </p>
            </div>
            <div class="w-6 h-[2px] bg-sky-400/80 rounded-full group-hover:w-12 group-hover:bg-sky-300 transition-all duration-300 shadow-[0_0_8px_rgba(56,189,248,0.7)]"></div>
          </div>

        </div>

        <!-- Bottom right accent line -->
        <div class="hidden lg:flex items-center justify-end gap-3 mt-12 select-none text-[9.5px] tracking-[0.25em] uppercase font-mono text-gray-400">
          <div class="w-16 h-px bg-gradient-to-r from-transparent to-sky-400"></div>
          <span>IDEAS · CÓDIGO · SOLUCIONES · RESULTADOS</span>
          <div class="w-16 h-px bg-gradient-to-l from-transparent to-sky-400"></div>
        </div>

      </div>

    </div>

  </div>
</section>\n