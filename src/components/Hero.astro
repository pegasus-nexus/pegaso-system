              Software a medida
            </h4>
            <p class="text-[9px] sm:text-[10px] lg:text-xs text-gray-300 font-light font-montserrat mt-0.5 leading-snug">
              Aplicaciones adaptadas<br class="hidden lg:inline" /> a tu negocio
            </p>
          </div>
        </div>

        <!-- 2: Automatización -->
        <div class="rounded-2xl bg-[#030712]/60 border border-white/[0.1] backdrop-blur-md p-2.5 sm:p-3 flex items-center gap-2.5 sm:gap-3 lg:bg-transparent lg:border-none lg:backdrop-blur-none lg:p-0 lg:px-6">
          <div class="relative flex items-center justify-center shrink-0">
            <div class="absolute -inset-1 sm:-inset-2 rounded-full bg-sky-500/25 blur-md sm:blur-lg"></div>
            <div class="relative w-9 h-9 sm:w-11 sm:h-11 lg:w-16 lg:h-16 rounded-full bg-[#030917] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </div>
          </div>
          <div class="min-w-0">
            <h4 class="text-[11px] sm:text-xs lg:text-base font-semibold text-white font-montserrat leading-tight truncate sm:whitespace-normal">
