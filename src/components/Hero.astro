</section>

<style>

/* =========================================================
   PEGASUS NEXUS
   TÍTULO LIMPIO — SIN FIGURAS NI LÍNEAS EN LAS LETRAS
   ========================================================= */

.pn-title {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  width: auto;

  margin: 0 0 1.25rem 0;

  padding: 0;

  text-align: left;

  line-height: 0.78;

  isolation: isolate;

  z-index: 50;

  /* MUY IMPORTANTE */
  font-family: Arial, Helvetica, sans-serif;

  background: transparent;
}


/* =========================================================
   PEGASUS
   ========================================================= */

.pn-pegasus {

  display: block;

  position: relative;

  margin: 0;
  padding: 0;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(3rem, 6vw, 5.5rem);

  font-weight: 900;

  font-style: normal;

  letter-spacing: 0.015em;

  line-height: 0.88;

  text-transform: uppercase;

  /* NEGRO PURO */
  color: #030711;

  -webkit-text-fill-color: #030711;

  /* BORDE */
  -webkit-text-stroke: 2px #edf7ff;

  /* GLOW EXTERIOR */
  text-shadow:
    0 0 2px #ffffff,
    0 0 5px #ffffff,
    0 0 12px #b5e2ff,
    0 0 25px #159cff,
    0 0 45px rgba(21,156,255,0.95),
    0 0 70px rgba(0,110,255,0.65);

  /*
    IMPORTANTE:
    ningún fondo,
    ninguna máscara,
    ningún clip,
    ninguna mezcla
  */

  background: transparent !important;
  background-image: none !important;

  -webkit-background-clip: initial !important;
  background-clip: initial !important;

  mask: none !important;
  -webkit-mask: none !important;

  clip-path: none !important;

  mix-blend-mode: normal !important;

  filter: none !important;

  transform: none !important;
}


/* =========================================================
   NEXUS
   ========================================================= */

.pn-nexus {

  display: block;

  position: relative;

  margin: -0.02em 0 0 0;

  padding-left: 0.05em;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(1.6rem, 3.2vw, 3rem);

  font-weight: 900;

  font-style: normal;

  letter-spacing: 0.35em;

  line-height: 0.88;

  text-transform: uppercase;

  color: #030711;

  -webkit-text-fill-color: #030711;

  -webkit-text-stroke: 1.6px #edf7ff;

  text-shadow:
    0 0 2px #ffffff,
    0 0 5px #ffffff,
    0 0 12px #b5e2ff,
    0 0 24px #159cff,
    0 0 42px rgba(21,156,255,0.9);

  background: transparent !important;
  background-image: none !important;

  -webkit-background-clip: initial !important;
  background-clip: initial !important;

  mask: none !important;
  -webkit-mask: none !important;

  clip-path: none !important;

  mix-blend-mode: normal !important;

  filter: none !important;

  transform: none !important;
}


/* =========================================================
   BLOQUEAR PSEUDOELEMENTOS
   ========================================================= */

.pn-title::before,
.pn-title::after,

.pn-pegasus::before,
.pn-pegasus::after,

.pn-nexus::before,
.pn-nexus::after {

  content: none !important;

  display: none !important;

