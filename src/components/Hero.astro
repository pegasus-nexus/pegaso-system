            </p>
          </div>
        </div>

        <!-- 3: Inteligencia de negocios -->
        <div class="rounded-2xl bg-[#030712]/60 border border-white/[0.1] backdrop-blur-md p-2.5 sm:p-3 flex items-center gap-2.5 sm:gap-3 lg:bg-transparent lg:border-none lg:backdrop-blur-none lg:p-0 lg:px-6">
          <div class="relative flex items-center justify-center shrink-0">
            <div class="absolute -inset-1 sm:-inset-2 rounded-full bg-sky-500/25 blur-md sm:blur-lg"></div>
            <div class="relative w-9 h-9 sm:w-11 sm:h-11 lg:w-16 lg:h-16 rounded-full bg-[#030917] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="currentColor">
                <rect x="4.5" y="11" width="3" height="9" rx="0.75"></rect>
                <rect x="10.5" y="5" width="3" height="15" rx="0.75"></rect>
                <rect x="16.5" y="13" width="3" height="7" rx="0.75"></rect>
              </svg>
            </div>
          </div>
          <div class="min-w-0">
            <h4 class="text-[11px] sm:text-xs lg:text-base font-semibold text-white font-montserrat leading-tight truncate sm:whitespace-normal">
              Inteligencia de negocios
            </h4>
            <p class="text-[9px] sm:text-[10px] lg:text-xs text-gray-300 font-light font-montserrat mt-0.5 leading-snug">
