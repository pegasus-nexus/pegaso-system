          <div class="flex items-center gap-1.5 sm:gap-3">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
