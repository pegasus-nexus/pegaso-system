---

---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col pt-32 pb-12 overflow-hidden bg-cosmos-dark"
  style="background-image: url('/hero-cosmos.jpg'); background-size: cover; background-position: center;"
>
  <!-- Lluvia de meteoritos intensa -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Capa 1: Lentos -->
    <div
      class="shooting-star"
      style="top: 10%; left: -10%; animation-delay: 0s; animation-duration: 15s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 30%; left: 40%; animation-delay: 4s; animation-duration: 12s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 60%; left: -20%; animation-delay: 8s; animation-duration: 18s;"
    >
    </div>

    <!-- Capa 2: Rápidos y pequeños (Meteoritos) -->
    <div
      class="meteorite"
      style="top: 5%; left: 10%; animation-delay: 2s; animation-duration: 3s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 25%; left: 50%; animation-delay: 5s; animation-duration: 4s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 15%; left: 80%; animation-delay: 1s; animation-duration: 2.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 45%; left: 5%; animation-delay: 7s; animation-duration: 3.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 70%; left: 60%; animation-delay: 3s; animation-duration: 2.8s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 85%; left: 20%; animation-delay: 9s; animation-duration: 4.2s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: -10%; left: 70%; animation-delay: 6s; animation-duration: 3.1s;"
    >
    </div>
  </div>

  <!-- Space subtle lighting without heavy dark blanket overlay -->
  <div class="absolute inset-0 bg-black/15 pointer-events-none z-0"></div>
  <!-- Bottom smooth blend to seamless cosmos-dark -->
  <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-cosmos-dark via-cosmos-dark/60 to-transparent pointer-events-none z-0"></div>

  <!-- Left vertical watermark -->
  <div class="hidden xl:flex absolute left-8 top-1/2 -translate-y-1/2 flex-col items-center select-none pointer-events-none z-20">
    <div class="w-px h-20 bg-white/25"></div>
    <span class="text-[9px] uppercase tracking-[0.35em] text-gray-400 font-montserrat font-light whitespace-nowrap -rotate-90 origin-center my-16">
      UN MUNDO DE POSIBILIDADES
    </span>
    <div class="w-px h-20 bg-white/25"></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex-grow flex flex-col justify-between pt-4 sm:pt-8 pb-4"
  >
    <!-- Left Hero Content Block -->
    <div class="hero-content-block text-left w-full max-w-2xl flex flex-col items-start relative mb-10 sm:mb-14">

      <!-- Subtitle badge with accent line -->
      <div class="flex items-center gap-3 mb-4 select-none">
        <div class="w-8 sm:w-12 h-[2px] bg-sky-400"></div>
        <h2
          class="text-sky-300 font-bold tracking-[0.3em] uppercase text-xs sm:text-sm font-montserrat"
        >
          EXCELENCIA EN SOFTWARE
        </h2>
      </div>

      <!-- PEGASUS NEXUS — TÍTULO PRINCIPAL -->
      <h1 class="pn-title" aria-label="Pegasus Nexus">
        <span class="pn-pegasus">PEGASUS</span>
        <span class="pn-nexus">NEXUS</span>
      </h1>

      <!-- Value Proposition Punchline (Exact text from mockup) -->
      <h3 class="text-2xl sm:text-4xl lg:text-[44px] font-bold text-white mb-4 tracking-tight leading-[1.15] font-montserrat">
        Software inteligente para <br />
        <span class="text-sky-400">transformar procesos</span><br />
        <span class="text-sky-400">empresariales.</span>
      </h3>

      <!-- Description paragraph -->
      <p
        id="hero-desc"
        class="text-xs sm:text-sm text-gray-300 font-montserrat font-light leading-relaxed max-w-xl mb-7"
      >
        Desarrollamos soluciones digitales, automatización e inteligencia de negocios para que tu empresa opere mejor, decida más rápido y crezca.
      </p>

      <!-- Action Buttons -->
      <div
        id="hero-buttons"
        class="flex flex-wrap items-center gap-4 mb-4"
      >
        <a
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20gustar%C3%ADa%20solicitar%20una%20evaluaci%C3%B3n%20inicial%20para%20mi%20empresa."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-gradient-to-r from-sky-500 via-sky-400 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-semibold text-xs sm:text-sm shadow-[0_0_25px_rgba(14,165,233,0.5)] hover:shadow-[0_0_35px_rgba(56,189,248,0.8)] hover:scale-105 transition-all cursor-pointer"
        >
          <span>Solicitar evaluación</span>
          <span class="text-sm">→</span>
        </a>
        <a
          href="#servicios"
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full border border-white/20 bg-white/5 hover:bg-white/10 hover:border-sky-400/60 text-white font-medium text-xs sm:text-sm transition-all cursor-pointer backdrop-blur-sm"
        >
          <svg class="w-3.5 h-3.5 fill-current text-white" viewBox="0 0 24 24">
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
          </svg>
          <span>Ver soluciones</span>
        </a>
      </div>

      <!-- Micro-badge Evaluación inicial gratuita -->
      <div class="flex items-center gap-2 text-sky-400 text-xs font-montserrat">
        <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="text-gray-300 text-xs font-light">Evaluación inicial gratuita</span>
      </div>

    </div>

    <!-- Middle 4 Capability Cards (Horizontal row matching mockup) -->
    <div class="w-full max-w-7xl mx-auto mb-8 relative z-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        
        <!-- 1: Software a medida -->
        <div class="flex items-center gap-3.5 p-3 sm:p-3.5 rounded-2xl bg-[#030712]/70 border border-white/[0.08] backdrop-blur-md hover:border-sky-400/40 transition-all duration-300 group">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#07132b] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] group-hover:scale-105 group-hover:border-sky-300 transition-all shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-semibold text-white font-montserrat leading-tight group-hover:text-sky-300 transition-colors">
              Software a medida
            </h4>
            <p class="text-[10px] sm:text-[11px] text-gray-400 font-light font-montserrat mt-0.5 leading-snug">
              Aplicaciones adaptadas a tu negocio
            </p>
          </div>
        </div>

        <!-- 2: Automatización -->
        <div class="flex items-center gap-3.5 p-3 sm:p-3.5 rounded-2xl bg-[#030712]/70 border border-white/[0.08] backdrop-blur-md hover:border-sky-400/40 transition-all duration-300 group">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#07132b] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] group-hover:scale-105 group-hover:border-sky-300 transition-all shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-semibold text-white font-montserrat leading-tight group-hover:text-sky-300 transition-colors">
              Automatización
            </h4>
            <p class="text-[10px] sm:text-[11px] text-gray-400 font-light font-montserrat mt-0.5 leading-snug">
              Reduce tiempos y errores
            </p>
          </div>
        </div>

        <!-- 3: Inteligencia de negocios -->
        <div class="flex items-center gap-3.5 p-3 sm:p-3.5 rounded-2xl bg-[#030712]/70 border border-white/[0.08] backdrop-blur-md hover:border-sky-400/40 transition-all duration-300 group">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#07132b] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] group-hover:scale-105 group-hover:border-sky-300 transition-all shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-semibold text-white font-montserrat leading-tight group-hover:text-sky-300 transition-colors">
              Inteligencia de negocios
            </h4>
            <p class="text-[10px] sm:text-[11px] text-gray-400 font-light font-montserrat mt-0.5 leading-snug">
              Decisiones con datos
            </p>
          </div>
        </div>

        <!-- 4: Integración de sistemas -->
        <div class="flex items-center gap-3.5 p-3 sm:p-3.5 rounded-2xl bg-[#030712]/70 border border-white/[0.08] backdrop-blur-md hover:border-sky-400/40 transition-all duration-300 group">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#07132b] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] group-hover:scale-105 group-hover:border-sky-300 transition-all shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-semibold text-white font-montserrat leading-tight group-hover:text-sky-300 transition-colors">
              Integración de sistemas
            </h4>
            <p class="text-[10px] sm:text-[11px] text-gray-400 font-light font-montserrat mt-0.5 leading-snug">
              Conecta tus plataformas
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Row: 3 Trust Pillars + Mouse Scroll (Matching mockup) -->
    <div class="w-full max-w-4xl mx-auto px-4 pt-4 border-t border-white/[0.08] flex flex-col items-center gap-4 relative z-20">
      
      <!-- 3 Pillars -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs text-gray-300 font-montserrat font-light">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          <span>Desarrollo personalizado</span>
        </div>

        <div class="hidden sm:block w-px h-3.5 bg-white/20"></div>

        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
          </svg>
          <span>Soporte continuo</span>
        </div>

        <div class="hidden sm:block w-px h-3.5 bg-white/20"></div>

        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Tecnología escalable</span>
        </div>
      </div>

      <!-- Mouse Scroll Indicator -->
      <a href="#por-que-nexus" class="flex flex-col items-center gap-1 text-[9px] font-mono tracking-[0.25em] uppercase text-gray-400 hover:text-sky-400 transition-colors group cursor-pointer pt-1">
        <div class="w-3.5 h-6 rounded-full border border-gray-400/60 flex items-start justify-center p-0.5 group-hover:border-sky-400 transition-colors">
          <div class="w-1 h-1.5 rounded-full bg-sky-400 animate-bounce"></div>
        </div>
        <span>DESCUBRE MÁS</span>
        <svg class="w-3 h-3 text-gray-400 group-hover:text-sky-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

    </div>

  </div>
</section>

<style>

/* =========================================================
   PEGASUS NEXUS
   TÍTULO LIMPIO — SIN FIGURAS NI LÍNEAS EN LAS LETRAS
   ========================================================= */

.pn-title {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  width: auto;

  margin: 0 0 1.25rem 0;

  padding: 0;

  text-align: left;

  line-height: 0.78;

  isolation: isolate;

  z-index: 50;

  /* MUY IMPORTANTE */
  font-family: Arial, Helvetica, sans-serif;

  background: transparent;
}


/* =========================================================
   PEGASUS
   ========================================================= */

.pn-pegasus {

  display: block;

  position: relative;

  margin: 0;
  padding: 0;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(3rem, 6vw, 5.5rem);

  font-weight: 900;

  font-style: normal;

  letter-spacing: 0.015em;

  line-height: 0.88;

  text-transform: uppercase;

  /* NEGRO PURO */
  color: #030711;

  -webkit-text-fill-color: #030711;

  /* BORDE */
  -webkit-text-stroke: 2px #edf7ff;

  /* GLOW EXTERIOR */
  text-shadow:
    0 0 2px #ffffff,
    0 0 5px #ffffff,
    0 0 12px #b5e2ff,
    0 0 25px #159cff,
    0 0 45px rgba(21,156,255,0.95),
    0 0 70px rgba(0,110,255,0.65);

  /*
    IMPORTANTE:
    ningún fondo,
    ninguna máscara,
    ningún clip,
    ninguna mezcla
  */

  background: transparent !important;
  background-image: none !important;

  -webkit-background-clip: initial !important;
  background-clip: initial !important;

  mask: none !important;
  -webkit-mask: none !important;

  clip-path: none !important;

  mix-blend-mode: normal !important;

  filter: none !important;

  transform: none !important;
}


/* =========================================================
   NEXUS
   ========================================================= */

.pn-nexus {

  display: block;

  position: relative;

  margin: -0.02em 0 0 0;

  padding-left: 0.05em;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(1.6rem, 3.2vw, 3rem);

  font-weight: 900;

  font-style: normal;

  letter-spacing: 0.35em;

  line-height: 0.88;

  text-transform: uppercase;

  color: #030711;

  -webkit-text-fill-color: #030711;

  -webkit-text-stroke: 1.6px #edf7ff;

  text-shadow:
    0 0 2px #ffffff,
    0 0 5px #ffffff,
    0 0 12px #b5e2ff,
    0 0 24px #159cff,
    0 0 42px rgba(21,156,255,0.9);

  background: transparent !important;
  background-image: none !important;

  -webkit-background-clip: initial !important;
  background-clip: initial !important;

  mask: none !important;
  -webkit-mask: none !important;

  clip-path: none !important;

  mix-blend-mode: normal !important;

  filter: none !important;

  transform: none !important;
}


/* =========================================================
   BLOQUEAR PSEUDOELEMENTOS
   ========================================================= */

.pn-title::before,
.pn-title::after,

.pn-pegasus::before,
.pn-pegasus::after,

.pn-nexus::before,
.pn-nexus::after {

  content: none !important;

  display: none !important;

  width: 0 !important;
  height: 0 !important;

  background: none !important;

  border: none !important;

  box-shadow: none !important;
}


/* =========================================================
   DESKTOP
   ========================================================= */

@media (min-width: 1200px) {

  .pn-pegasus {
    font-size: 5.5rem;
  }

  .pn-nexus {
    font-size: 3rem;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .pn-pegasus {
    font-size: clamp(2.8rem, 8vw, 4.5rem);
  }

  .pn-nexus {
    font-size: clamp(1.4rem, 4.2vw, 2.4rem);
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .pn-title {
    line-height: 0.84;
  }

  .pn-pegasus {

    font-size: clamp(
      2.4rem,
      11vw,
      3.6rem
    );

    letter-spacing: 0.005em;

    -webkit-text-stroke: 1.4px #edf7ff;
  }

  .pn-nexus {

    font-size: clamp(
      1.2rem,
      5.8vw,
      1.9rem
    );

    letter-spacing: 0.32em;

    padding-left: 0.05em;

    -webkit-text-stroke: 1.2px #edf7ff;
  }

}

</style>
