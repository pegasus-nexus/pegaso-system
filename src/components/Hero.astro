      <!-- Row 2: Horizontal line divider, 3 Trust Pillars and Mouse Scroll matching screenshot -->
      <div class="w-full pt-3 sm:pt-5 border-t border-white/[0.15] flex flex-col items-center gap-4">
        
        <!-- 3 Trust Pillars -->
