---

---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col pt-32 pb-12 overflow-hidden bg-cosmos-dark"
  style="background-image: url('/hero-cosmos.jpg'); background-size: cover; background-position: center;"
>
  <!-- Lluvia de meteoritos intensa -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Capa 1: Lentos -->
    <div
      class="shooting-star"
      style="top: 10%; left: -10%; animation-delay: 0s; animation-duration: 15s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 30%; left: 40%; animation-delay: 4s; animation-duration: 12s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 60%; left: -20%; animation-delay: 8s; animation-duration: 18s;"
    >
    </div>

    <!-- Capa 2: Rápidos y pequeños (Meteoritos) -->
    <div
      class="meteorite"
      style="top: 5%; left: 10%; animation-delay: 2s; animation-duration: 3s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 25%; left: 50%; animation-delay: 5s; animation-duration: 4s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 15%; left: 80%; animation-delay: 1s; animation-duration: 2.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 45%; left: 5%; animation-delay: 7s; animation-duration: 3.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 70%; left: 60%; animation-delay: 3s; animation-duration: 2.8s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 85%; left: 20%; animation-delay: 9s; animation-duration: 4.2s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: -10%; left: 70%; animation-delay: 6s; animation-duration: 3.1s;"
    >
    </div>
  </div>

  <!-- Space subtle lighting without heavy dark blanket overlay -->
  <div class="absolute inset-0 bg-black/10 pointer-events-none z-0"></div>

  <!-- Left vertical watermark -->
  <div class="hidden xl:flex absolute left-8 top-1/2 -translate-y-1/2 flex-col items-center select-none pointer-events-none z-20">
    <div class="w-px h-20 bg-white/25"></div>
    <span class="text-[9px] uppercase tracking-[0.35em] text-gray-400 font-montserrat font-light whitespace-nowrap -rotate-90 origin-center my-16">
      UN MUNDO DE POSIBILIDADES
    </span>
    <div class="w-px h-20 bg-white/25"></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex-grow flex flex-col items-center justify-center pt-8 pb-8"
  >
    <div class="text-center w-full max-w-4xl mx-auto flex flex-col items-center relative">

      <!-- Subtitle badge with horizontal lines -->
      <div class="flex items-center justify-center gap-4 mb-5">
        <div class="w-8 sm:w-16 h-px bg-white/40"></div>
        <h2
          class="text-white font-bold tracking-[0.35em] sm:tracking-[0.45em] uppercase text-xs sm:text-sm font-montserrat"
        >
          EXCELENCIA EN SOFTWARE
        </h2>
        <div class="w-8 sm:w-16 h-px bg-white/40"></div>
      </div>

      <!-- Main Title: PEGASUS NEXUS -->
      <h1
        class="pegasus-title select-none"
        aria-label="Pegasus Nexus"
      >
        <span class="pegasus-word">PEGASUS</span>
        <span class="nexus-word">NEXUS</span>
      </h1>

      <!-- Value Proposition Punchline -->
      <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3 tracking-tight font-montserrat">
        Transformamos tecnología <span class="text-sky-400 font-bold">en resultados.</span>
      </h3>

      <!-- Description paragraph -->
      <p
        id="hero-desc"
        class="text-xs sm:text-sm md:text-base text-gray-300 font-montserrat font-light tracking-wide max-w-2xl mx-auto mb-8 leading-relaxed px-4 sm:px-0"
      >
        Desarrollamos software, automatizamos procesos e integramos soluciones inteligentes para que tu empresa opere mejor, decida más rápido y crezca.
      </p>

      <!-- Action Buttons -->
      <div
        id="hero-buttons"
        class="flex flex-col sm:flex-row gap-4 sm:gap-5 justify-center items-center w-full px-6 sm:px-0 mb-12 sm:mb-14"
      >
        <a
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20gustar%C3%ADa%20solicitar%20un%20diagn%C3%B3stico%20para%20mi%20empresa."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-blue-600 via-sky-500 to-sky-400 text-white font-semibold text-xs sm:text-sm uppercase tracking-wider shadow-[0_0_28px_rgba(14,165,233,0.85)] hover:shadow-[0_0_42px_rgba(56,189,248,1)] hover:scale-105 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Solicitar Diagnóstico</span>
          <span class="text-base leading-none">→</span>
        </a>
        <a
          href="#por-que-nexus"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-transparent border border-white/50 hover:border-sky-400 text-white font-medium text-xs sm:text-sm uppercase tracking-wider hover:bg-white/10 hover:scale-105 transition-all flex items-center justify-center gap-2.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
          </svg>
          <span>Ver Soluciones</span>
        </a>
      </div>

    </div>

    <!-- Feature Icons & Odoo Partner Bar (Clean floating layout with dividers, exactly like mockup) -->
    <div class="w-full max-w-6xl mx-auto px-2 sm:px-4 mb-10 relative z-20">
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-12 gap-6 lg:gap-0 items-center py-2">
        
        <!-- 1: Software a medida -->
        <div class="lg:col-span-2 flex flex-col items-center text-center px-2 lg:border-r lg:border-white/20 group">
          <div class="w-8 h-8 mb-1.5 flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white font-montserrat">Software</span>
          <span class="text-[11px] text-gray-300 font-light font-montserrat">a medida</span>
        </div>

        <!-- 2: Automatización de procesos -->
        <div class="lg:col-span-2 flex flex-col items-center text-center px-2 lg:border-r lg:border-white/20 group">
          <div class="w-8 h-8 mb-1.5 flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white font-montserrat">Automatización</span>
          <span class="text-[11px] text-gray-300 font-light font-montserrat">de procesos</span>
        </div>

        <!-- 3: Inteligencia de negocios -->
        <div class="lg:col-span-2 flex flex-col items-center text-center px-2 lg:border-r lg:border-white/20 group">
          <div class="w-8 h-8 mb-1.5 flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white font-montserrat">Inteligencia</span>
          <span class="text-[11px] text-gray-300 font-light font-montserrat">de negocios</span>
        </div>

        <!-- 4: Integración de sistemas -->
        <div class="lg:col-span-2 flex flex-col items-center text-center px-2 lg:border-r lg:border-white/20 group">
          <div class="w-8 h-8 mb-1.5 flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white font-montserrat">Integración</span>
          <span class="text-[11px] text-gray-300 font-light font-montserrat">de sistemas</span>
        </div>

        <!-- Partner Odoo Block -->
        <div class="col-span-2 lg:col-span-3 flex flex-col items-center lg:items-start pl-0 lg:pl-6">
          <span class="text-[9px] sm:text-[10px] text-gray-400 tracking-[0.2em] uppercase font-montserrat font-semibold mb-1">
            PARTNER TECNOLÓGICO
          </span>
          <div class="flex items-center gap-3">
            <img src="/logo-odoo.png" alt="Odoo Partner Tecnológico" class="h-6 sm:h-7 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(169,76,146,0.6)]" />
            <div class="hidden sm:block w-px h-6 bg-white/20"></div>
            <p class="text-[10px] sm:text-[11px] text-gray-300 font-light leading-snug">
              Implementación, personalización y soporte empresarial.
            </p>
          </div>
        </div>

        <!-- Far right quote -->
        <div class="hidden lg:flex lg:col-span-1 justify-end">
          <span class="text-[11px] text-gray-400 italic font-light whitespace-nowrap text-right">
            "Ideas que<br />conectan realidades"
          </span>
        </div>

      </div>
    </div>

    <!-- Very bottom line bar -->
    <div class="w-full max-w-7xl mx-auto px-4 hidden md:flex items-center justify-between text-[11px] text-gray-400/90 font-light pt-2 pb-2 relative z-20">
      <span class="italic max-w-xs text-left">
        "La tecnología bien aplicada, también puede hacer un mundo mejor"
      </span>
      
      <a href="#por-que-nexus" class="flex flex-col items-center gap-1 text-[10px] tracking-[0.25em] uppercase text-gray-300 hover:text-sky-400 transition-colors group">
        <div class="w-4 h-7 rounded-full border border-gray-400/60 flex items-start justify-center p-0.5 group-hover:border-sky-400 transition-colors">
          <div class="w-1 h-2 rounded-full bg-sky-400 animate-bounce"></div>
        </div>
        <span>DESCUBRE MÁS</span>
        <svg class="w-3 h-3 text-gray-400 group-hover:text-sky-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

      <div class="flex flex-col items-end gap-1">
        <div class="w-24 h-[2px] bg-gradient-to-r from-transparent to-sky-400 shadow-[0_0_8px_#38bdf8]"></div>
        <span class="text-[9px] tracking-[0.25em] uppercase font-mono text-gray-400">
          IDEAS • CÓDIGO • SOLUCIONES • RESULTADOS
        </span>
      </div>
    </div>

  </div>
</section>

<style>
  /* =====================================================
     PEGASUS NEXUS — TITULO PRINCIPAL
     Estilo: oscuro + borde luminoso + glow azul
     ===================================================== */

  .pegasus-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    margin: 0 0 2rem 0;

    text-align: center;
    line-height: 0.78;

    position: relative;
    z-index: 10;
  }


  /* =====================================================
     PEGASUS
     ===================================================== */

  .pegasus-word {
    position: relative;
    display: inline-block;

    font-family: 'Montserrat', sans-serif;

    font-size: clamp(
      4.5rem,
      9vw,
      8.5rem
    );

    font-weight: 900;

    letter-spacing: 0.025em;
    line-height: 0.9;

    text-transform: uppercase;

    /* INTERIOR OSCURO */
    color: #050914;

    /*
     * IMPORTANTE:
     * NO usar background-clip:text
     * NO usar text-fill transparent
     */

    -webkit-text-fill-color: #050914;

    /* BORDE */
    -webkit-text-stroke: 2px #eaf5ff;

    /* =================================================
       GLOW EXTERIOR
       ================================================= */

    text-shadow:

      /* borde blanco */
      0 0 2px #ffffff,

      /* halo cercano */
      0 0 7px #ffffff,

      /* azul eléctrico */
      0 0 14px #55baff,

      0 0 25px #168cff,

      0 0 45px rgba(0, 132, 255, 0.95),

      0 0 75px rgba(0, 100, 255, 0.65);

    filter:
      drop-shadow(
        0 0 10px rgba(0, 150, 255, 0.85)
      )
      drop-shadow(
        0 0 30px rgba(0, 110, 255, 0.65)
      );
  }


  /* =====================================================
     LÍNEA DE LUZ QUE ATRAVIESA PEGASUS
     ===================================================== */

  .pegasus-word::after {
    content: "";

    position: absolute;

    left: -7%;
    right: -7%;

    top: 52%;

    height: 2px;

    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255,255,255,0.15) 10%,
      #ffffff 25%,
      #43b8ff 50%,
      #ffffff 75%,
      rgba(255,255,255,0.15) 90%,
      transparent 100%
    );

    box-shadow:
      0 0 5px #ffffff,
      0 0 14px #168cff,
      0 0 28px #168cff;

    opacity: 0.9;

    pointer-events: none;
  }


  /* =====================================================
     NEXUS
     ===================================================== */

  .nexus-word {
    position: relative;

    z-index: 20;

    display: inline-block;

    margin-top: -0.04em;

    font-family: 'Montserrat', sans-serif;

    font-size: clamp(
      2.2rem,
      5vw,
      5.2rem
    );

    font-weight: 900;

    letter-spacing: 0.38em;

    padding-left: 0.38em;

    line-height: 0.9;

    text-transform: uppercase;

    /* INTERIOR OSCURO */
    color: #050914;

    -webkit-text-fill-color: #050914;

    /* BORDE */
    -webkit-text-stroke: 1.6px #eaf5ff;

    /* GLOW */

    text-shadow:

      0 0 2px #ffffff,

      0 0 7px #ffffff,

      0 0 15px #58bfff,

      0 0 28px #168cff,

      0 0 45px rgba(0, 130, 255, 0.9);

    filter:
      drop-shadow(
        0 0 8px rgba(0, 150, 255, 0.85)
      )
      drop-shadow(
        0 0 22px rgba(0, 110, 255, 0.6)
      );
  }


  /* =====================================================
     BRILLO SUTIL ANIMADO
     ===================================================== */

  @keyframes pegasusGlow {

    0% {
      filter:
        drop-shadow(
          0 0 8px rgba(0, 150, 255, 0.65)
        )
        drop-shadow(
          0 0 22px rgba(0, 110, 255, 0.4)
        );
    }

    50% {
      filter:
        drop-shadow(
          0 0 14px rgba(0, 180, 255, 0.95)
        )
        drop-shadow(
          0 0 35px rgba(0, 120, 255, 0.7)
        );
    }

    100% {
      filter:
        drop-shadow(
          0 0 8px rgba(0, 150, 255, 0.65)
        )
        drop-shadow(
          0 0 22px rgba(0, 110, 255, 0.4)
        );
    }

  }

  .pegasus-word {
    animation:
      pegasusGlow 4s ease-in-out infinite;
  }


  /* =====================================================
     RESPONSIVE
     ===================================================== */

  @media (max-width: 768px) {

    .pegasus-title {
      line-height: 0.84;
      margin-bottom: 1.5rem;
    }

    .pegasus-word {

      font-size:
        clamp(
          3.4rem,
          16vw,
          6rem
        );

      letter-spacing: 0.015em;

      -webkit-text-stroke:
        1.5px #eaf5ff;
    }

    .nexus-word {

      font-size:
        clamp(
          1.8rem,
          9vw,
          3.5rem
        );

      letter-spacing: 0.30em;

      padding-left: 0.30em;

      -webkit-text-stroke:
        1.3px #eaf5ff;
    }

  }


  /* =====================================================
     PANTALLAS MUY PEQUEÑAS
     ===================================================== */

  @media (max-width: 480px) {

    .pegasus-word {
      font-size: 3.1rem;
    }

    .nexus-word {
      font-size: 1.7rem;
      letter-spacing: 0.25em;
      padding-left: 0.25em;
    }

  }

  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
  .animate-pulse-slow {
    animation: pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes float {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-15px) rotate(1deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }
</style>
