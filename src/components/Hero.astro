            </p>
          </div>
        </div>

        <!-- 4: Integración de sistemas -->
        <div class="rounded-2xl bg-[#030712]/60 border border-white/[0.1] backdrop-blur-md p-2.5 sm:p-3 flex items-center gap-2.5 sm:gap-3 lg:bg-transparent lg:border-none lg:backdrop-blur-none lg:p-0 lg:px-6 lg:last:pr-0">
          <div class="relative flex items-center justify-center shrink-0">
            <div class="absolute -inset-1 sm:-inset-2 rounded-full bg-sky-500/25 blur-md sm:blur-lg"></div>
            <div class="relative w-9 h-9 sm:w-11 sm:h-11 lg:w-16 lg:h-16 rounded-full bg-[#030917] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="2.5"></circle>
                <circle cx="5.5" cy="5.5" r="2"></circle>
                <circle cx="18.5" cy="5.5" r="2"></circle>
                <circle cx="5.5" cy="18.5" r="2"></circle>
