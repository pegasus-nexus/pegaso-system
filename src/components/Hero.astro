---

---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col pt-32 pb-12 overflow-hidden bg-cosmos-dark"
  style="background-image: url('/hero-cosmos.jpg'); background-size: cover; background-position: center;"
>
  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-cosmos-dark/50 backdrop-blur-[1px]"></div>

  <div class="absolute inset-0 bg-stars opacity-40"></div>

  <!-- Lluvia de meteoritos intensa -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Capa 1: Lentos -->
    <div
      class="shooting-star"
      style="top: 10%; left: -10%; animation-delay: 0s; animation-duration: 15s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 30%; left: 40%; animation-delay: 4s; animation-duration: 12s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 60%; left: -20%; animation-delay: 8s; animation-duration: 18s;"
    >
    </div>

    <!-- Capa 2: Rápidos y pequeños (Meteoritos) -->
    <div
      class="meteorite"
      style="top: 5%; left: 10%; animation-delay: 2s; animation-duration: 3s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 25%; left: 50%; animation-delay: 5s; animation-duration: 4s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 15%; left: 80%; animation-delay: 1s; animation-duration: 2.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 45%; left: 5%; animation-delay: 7s; animation-duration: 3.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 70%; left: 60%; animation-delay: 3s; animation-duration: 2.8s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 85%; left: 20%; animation-delay: 9s; animation-duration: 4.2s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: -10%; left: 70%; animation-delay: 6s; animation-duration: 3.1s;"
    >
    </div>
  </div>

  <!-- Left vertical watermark -->
  <div class="hidden xl:flex absolute left-8 top-1/2 -translate-y-1/2 items-center gap-4 -rotate-90 origin-left select-none pointer-events-none z-20">
    <span class="text-[10px] uppercase tracking-[0.35em] text-gray-400 font-montserrat font-light whitespace-nowrap">
      UN MUNDO DE POSIBILIDADES
    </span>
    <div class="w-16 h-px bg-white/20"></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex-grow flex flex-col items-center justify-center pt-8 pb-16"
  >
    <div class="text-center w-full max-w-4xl mx-auto flex flex-col items-center">
      
      <!-- Subtitle badge with horizontal lines -->
      <div class="flex items-center justify-center gap-4 mb-5">
        <div class="w-8 sm:w-16 h-px bg-white/30"></div>
        <h2
          class="text-white/90 font-bold tracking-[0.35em] sm:tracking-[0.45em] uppercase text-xs sm:text-sm font-montserrat"
        >
          EXCELENCIA EN SOFTWARE
        </h2>
        <div class="w-8 sm:w-16 h-px bg-white/30"></div>
      </div>

      <!-- Main Title: PEGASUS NEXUS with electric blue neon backlight glow -->
      <h1 class="flex flex-col mb-5 items-center w-full select-none">
        <span
          class="font-montserrat text-6xl sm:text-8xl md:text-9xl lg:text-[7.5rem] xl:text-[8.5rem] font-black uppercase tracking-wider leading-none"
          style="color: #060b18; -webkit-text-stroke: 1.5px rgba(186, 230, 253, 0.9); text-shadow: 0 0 12px rgba(56, 189, 248, 0.95), 0 0 28px rgba(14, 165, 233, 0.9), 0 0 60px rgba(2, 132, 199, 0.8), 0 0 100px rgba(37, 99, 235, 0.65); filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.9));"
        >
          PEGASUS
        </span>
        <span
          class="font-montserrat font-black text-3xl sm:text-5xl md:text-6xl lg:text-[4.5rem] xl:text-[5rem] tracking-[0.35em] uppercase mt-[-4px] sm:mt-[-12px] md:mt-[-16px] leading-none"
          style="color: #060b18; -webkit-text-stroke: 1.2px rgba(186, 230, 253, 0.85); text-shadow: 0 0 10px rgba(56, 189, 248, 0.9), 0 0 24px rgba(14, 165, 233, 0.85), 0 0 50px rgba(2, 132, 199, 0.75), 0 0 80px rgba(37, 99, 235, 0.6); filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.9));"
        >
          NEXUS
        </span>
      </h1>

      <!-- Value Proposition Punchline -->
      <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3 tracking-tight font-montserrat">
        Transformamos tecnología <span class="text-sky-400 font-bold">en resultados.</span>
      </h3>

      <!-- Description paragraph -->
      <p
        id="hero-desc"
        class="text-xs sm:text-sm md:text-base text-gray-300 font-montserrat font-light tracking-wide max-w-2xl mx-auto mb-8 leading-relaxed px-4 sm:px-0"
      >
        Desarrollamos software, automatizamos procesos e integramos soluciones inteligentes para que tu empresa opere mejor, decida más rápido y crezca.
      </p>

      <!-- Action Buttons -->
      <div
        id="hero-buttons"
        class="flex flex-col sm:flex-row gap-4 sm:gap-5 justify-center items-center w-full px-6 sm:px-0 mb-12 sm:mb-16"
      >
        <a
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20gustar%C3%ADa%20solicitar%20un%20diagn%C3%B3stico%20para%20mi%20empresa."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-blue-600 via-blue-500 to-sky-400 text-white font-semibold text-xs sm:text-sm uppercase tracking-wider shadow-[0_0_25px_rgba(14,165,233,0.7)] hover:shadow-[0_0_40px_rgba(56,189,248,0.95)] hover:scale-105 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Solicitar Diagnóstico</span>
          <span class="text-base leading-none">→</span>
        </a>
        <a
          href="#por-que-nexus"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-transparent border border-white/40 hover:border-sky-400 text-white font-medium text-xs sm:text-sm uppercase tracking-wider hover:bg-white/5 hover:scale-105 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-sky-400 fill-current" viewBox="0 0 24 24">
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
          </svg>
          <span>Ver Soluciones</span>
        </a>
      </div>

    </div>

    <!-- Feature Icons & Odoo Partner Bar -->
    <div class="w-full max-w-6xl mx-auto px-2 sm:px-4 mb-8 relative z-20">
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-12 gap-4 lg:gap-4 items-center py-4 px-4 sm:px-6 rounded-2xl bg-[#091024]/75 backdrop-blur-md border border-sky-500/20 shadow-[0_10px_30px_rgba(0,0,0,0.6)]">
        
        <!-- 1: Software a medida -->
        <div class="lg:col-span-2 flex flex-col items-center text-center group">
          <div class="w-9 h-9 mb-1.5 rounded-xl flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white">Software</span>
          <span class="text-[11px] text-gray-400 font-light">a medida</span>
        </div>

        <!-- 2: Automatización de procesos -->
        <div class="lg:col-span-2 flex flex-col items-center text-center group">
          <div class="w-9 h-9 mb-1.5 rounded-xl flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white">Automatización</span>
          <span class="text-[11px] text-gray-400 font-light">de procesos</span>
        </div>

        <!-- 3: Inteligencia de negocios -->
        <div class="lg:col-span-2 flex flex-col items-center text-center group">
          <div class="w-9 h-9 mb-1.5 rounded-xl flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white">Inteligencia</span>
          <span class="text-[11px] text-gray-400 font-light">de negocios</span>
        </div>

        <!-- 4: Integración de sistemas -->
        <div class="lg:col-span-2 flex flex-col items-center text-center group">
          <div class="w-9 h-9 mb-1.5 rounded-xl flex items-center justify-center text-sky-400 transition-transform group-hover:scale-110">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-white">Integración</span>
          <span class="text-[11px] text-gray-400 font-light">de sistemas</span>
        </div>

        <!-- Vertical separator (visible on desktop) -->
        <div class="hidden lg:block w-px h-12 bg-white/15 mx-auto"></div>

        <!-- Partner Odoo Block -->
        <div class="col-span-2 lg:col-span-3 flex flex-col items-center lg:items-start pl-0 lg:pl-2">
          <span class="text-[9px] sm:text-[10px] text-gray-400 tracking-[0.2em] uppercase font-montserrat font-semibold mb-1">
            PARTNER TECNOLÓGICO
          </span>
          <div class="flex items-center gap-3">
            <img src="/logo-odoo.png" alt="Odoo Partner Tecnológico" class="h-6 sm:h-7 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(169,76,146,0.6)]" />
            <p class="text-[10px] sm:text-[11px] text-gray-300 font-light leading-snug">
              Implementación, personalización y soporte empresarial.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- Very bottom line bar -->
    <div class="w-full max-w-7xl mx-auto px-4 hidden md:flex items-center justify-between text-[11px] text-gray-400/90 font-light pb-2 relative z-20">
      <span class="italic max-w-xs text-left">
        "La tecnología bien aplicada, también puede hacer un mundo mejor"
      </span>
      
      <a href="#desafios" class="flex flex-col items-center gap-1 text-[10px] tracking-[0.25em] uppercase text-gray-300 hover:text-sky-400 transition-colors group">
        <div class="w-4 h-7 rounded-full border border-gray-400/60 flex items-start justify-center p-0.5 group-hover:border-sky-400 transition-colors">
          <div class="w-1 h-2 rounded-full bg-sky-400 animate-bounce"></div>
        </div>
        <span>DESCUBRE MÁS</span>
        <svg class="w-3 h-3 text-gray-400 group-hover:text-sky-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

      <div class="flex flex-col items-end gap-1">
        <div class="w-20 h-[2px] bg-gradient-to-r from-transparent to-sky-400"></div>
        <span class="text-[9px] tracking-[0.25em] uppercase font-mono text-gray-400">
          IDEAS • CÓDIGO • SOLUCIONES • RESULTADOS
        </span>
      </div>
    </div>

  </div>

  <!-- Wavy Divider adapted for dark mode -->
  <div
    class="absolute bottom-0 w-full overflow-hidden leading-[0] transform translate-y-1 z-20"
  >
    <svg
      class="relative block w-[calc(100%+1.3px)] h-[80px]"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C52.16,93.45,103.9,82.16,154,71.2,209.68,59,265.2,46.85,321.39,56.44Z"
        fill="#131726"></path>
    </svg>
  </div>
</section>

<style>
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
  .animate-pulse-slow {
    animation: pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes float {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-15px) rotate(1deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }
</style>
