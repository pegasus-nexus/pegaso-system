---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col pt-32 pb-12 overflow-hidden bg-cosmos-dark"
  style="background-image: url('/hero-cosmos.jpg'); background-size: cover; background-position: center;"
>
  <!-- Lluvia de meteoritos intensa -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Capa 1: Lentos -->
    <div
      class="shooting-star"
      style="top: 10%; left: -10%; animation-delay: 0s; animation-duration: 15s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 30%; left: 40%; animation-delay: 4s; animation-duration: 12s;"
    >
    </div>
    <div
      class="shooting-star"
      style="top: 60%; left: -20%; animation-delay: 8s; animation-duration: 18s;"
    >
    </div>

    <!-- Capa 2: Rápidos y pequeños (Meteoritos) -->
    <div
      class="meteorite"
      style="top: 5%; left: 10%; animation-delay: 2s; animation-duration: 3s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 25%; left: 50%; animation-delay: 5s; animation-duration: 4s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 15%; left: 80%; animation-delay: 1s; animation-duration: 2.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 45%; left: 5%; animation-delay: 7s; animation-duration: 3.5s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 70%; left: 60%; animation-delay: 3s; animation-duration: 2.8s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: 85%; left: 20%; animation-delay: 9s; animation-duration: 4.2s;"
    >
    </div>
    <div
      class="meteorite"
      style="top: -10%; left: 70%; animation-delay: 6s; animation-duration: 3.1s;"
    >
    </div>
  </div>

  <!-- Bottom smooth blend to seamless cosmos-dark -->
  <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-cosmos-dark to-transparent pointer-events-none z-0"></div>

  <!-- Left vertical watermark -->
  <div class="hidden xl:flex absolute left-8 top-1/2 -translate-y-1/2 flex-col items-center select-none pointer-events-none z-20">
    <div class="w-px h-20 bg-white/25"></div>
    <span class="text-[9px] uppercase tracking-[0.35em] text-gray-400 font-montserrat font-light whitespace-nowrap -rotate-90 origin-center my-16">
      UN MUNDO DE POSIBILIDADES
    </span>
    <div class="w-px h-20 bg-white/25"></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex-grow flex flex-col justify-between pt-2 sm:pt-8 pb-4"
  >
    <!-- Hero Content Block (Centered container on mobile, left-aligned on desktop) -->
    <div class="hero-content-block text-left w-full max-w-2xl flex flex-col items-center sm:items-start relative mb-8 sm:mb-14">
      
      <!-- Difuminado negro leve EXCLUSIVAMENTE en el área del texto -->
      <div class="absolute -inset-4 sm:-inset-6 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.6)_0%,rgba(0,0,0,0.25)_50%,transparent_75%)] blur-xl -z-10 pointer-events-none"></div>

      <!-- Subtitle badge with accent lines (Centered on mobile with 2 lines, left on desktop) -->
      <div class="w-full flex items-center justify-center sm:justify-start gap-2.5 sm:gap-3 mb-3 sm:mb-4 select-none">
        <div class="w-8 sm:w-12 h-[1.5px] bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)]"></div>
        <h2
          class="text-sky-300 font-bold tracking-[0.25em] sm:tracking-[0.3em] uppercase text-[10px] sm:text-sm font-montserrat drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
        >
          EXCELENCIA EN SOFTWARE
        </h2>
        <div class="w-8 h-[1.5px] bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)] sm:hidden"></div>
      </div>

      <!-- PEGASUS NEXUS — TÍTULO PRINCIPAL (Centrado en móvil, a la izquierda en desktop) -->
      <h1 class="pn-title w-full" aria-label="Pegasus Nexus">
        <span class="pn-pegasus">PEGASUS</span>
        <span class="pn-nexus">NEXUS</span>
      </h1>

      <!-- Value Proposition Punchline -->
      <h3 class="w-full text-[23px] sm:text-4xl lg:text-[44px] font-bold text-white mb-3 sm:mb-4 tracking-tight leading-[1.2] sm:leading-[1.15] font-montserrat drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
        Software inteligente para <br />
        <span class="text-sky-400 drop-shadow-[0_0_20px_rgba(56,189,248,0.4)]">transformar procesos</span><br />
        <span class="text-sky-400 drop-shadow-[0_0_20px_rgba(56,189,248,0.4)]">empresariales.</span>
      </h3>

      <!-- Description paragraph -->
      <p
        id="hero-desc"
        class="w-full text-xs sm:text-sm text-gray-200 font-montserrat font-light leading-relaxed max-w-xl mb-5 sm:mb-7 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]"
      >
        Desarrollamos soluciones digitales, automatización e inteligencia de negocios para que tu empresa opere mejor, decida más rápido y crezca.
      </p>

      <!-- Action Buttons (Full-width stacked on mobile, inline on desktop) -->
      <div
        id="hero-buttons"
        class="w-full flex flex-col sm:flex-row items-center gap-3 sm:gap-4 mb-3 sm:mb-4"
      >
        <a
          href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20gustar%C3%ADa%20solicitar%20una%20evaluaci%C3%B3n%20inicial%20para%20mi%20empresa."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 sm:py-3 rounded-full bg-gradient-to-r from-sky-500 via-sky-400 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-semibold text-xs sm:text-sm shadow-[0_0_25px_rgba(14,165,233,0.5)] hover:shadow-[0_0_35px_rgba(56,189,248,0.8)] hover:scale-[1.02] sm:hover:scale-105 transition-all cursor-pointer text-center"
        >
          <span>Solicitar evaluación</span>
          <span class="text-sm">→</span>
        </a>
        <a
          href="#servicios"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full border border-white/20 bg-white/5 hover:bg-white/10 hover:border-sky-400/60 text-white font-medium text-xs sm:text-sm transition-all cursor-pointer backdrop-blur-sm text-center"
        >
          <svg class="w-3.5 h-3.5 fill-current text-white shrink-0" viewBox="0 0 24 24">
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
          </svg>
          <span>Ver soluciones</span>
        </a>
      </div>

      <!-- Micro-badge Evaluación inicial gratuita -->
      <div class="w-full flex items-center justify-center sm:justify-start gap-2 text-sky-400 text-xs font-montserrat">
        <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="text-gray-200 text-xs font-normal drop-shadow-[0_1px_3px_rgba(0,0,0,0.8)]">Evaluación inicial gratuita</span>
      </div>

    </div>

    <!-- Bottom Capability & Trust Modules (2x2 grid on mobile, 4-col bar on desktop matching mockups) -->
    <div class="w-full max-w-7xl mx-auto pt-4 sm:pt-6 pb-2 relative z-20">
      
      <!-- Row 1: 4 Capabilities (2x2 cards on mobile, transparent row on desktop) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 lg:gap-0 lg:divide-x lg:divide-white/[0.12] pb-4 sm:pb-6">
        
        <!-- 1: Software a medida -->
        <div class="rounded-2xl bg-[#030712]/60 border border-white/[0.1] backdrop-blur-md p-2.5 sm:p-3 flex items-center gap-2.5 sm:gap-3 lg:bg-transparent lg:border-none lg:backdrop-blur-none lg:p-0 lg:px-6 lg:first:pl-0">
          <div class="relative flex items-center justify-center shrink-0">
            <div class="absolute -inset-1 sm:-inset-2 rounded-full bg-sky-500/25 blur-md sm:blur-lg"></div>
            <div class="relative w-9 h-9 sm:w-11 sm:h-11 lg:w-16 lg:h-16 rounded-full bg-[#030917] border border-sky-400/40 flex items-center justify-center text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
