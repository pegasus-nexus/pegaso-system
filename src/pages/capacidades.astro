---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/capacidades.css';
import { CapacidadesApp } from '../components/assessment/CapacidadesApp';
---

<Layout 
  title="Capacidades - Evaluación de Capacidades Empresariales"
  description="Descubre las capacidades de gestión de tu empresa en minutos con nuestra evaluación orientativa."
>
  <Header />
  
  <main class="pt-32 pb-20 min-h-screen relative z-10">
    <div class="container mx-auto px-4">
      {/* Evaluación de Capacidades: flujo de 5 pasos que se ejecuta en el cliente */}
      <CapacidadesApp client:only="react" />
    </div>
  </main>
  
  <Footer />
</Layout>