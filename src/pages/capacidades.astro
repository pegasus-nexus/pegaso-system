---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/capacidades.css';
import { CapacidadesApp } from '../components/assessment/CapacidadesApp';
---

<Layout 
  title="Capacidades - Evaluación de Capacidades Empresariales"
  description="Descubre las capacidades de gestión de tu empresa en minutos con nuestra evaluación orientativa."
>
  <!-- Fondo cósmico nítido y vibrante sin manto oscuro -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <img 
      src="/capacidades-bg.jpg" 
      alt="Fondo cósmico de capacidades" 
      class="w-full h-full object-cover object-center"
    />
  </div>

  <Header />
  
  <main class="pt-28 md:pt-32 pb-20 min-h-screen relative z-10">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Botón para volver a la página principal -->
      <div class="mb-6">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/70 hover:bg-slate-800/90 border border-sky-400/30 hover:border-sky-400/70 text-slate-200 hover:text-white text-xs font-semibold backdrop-blur-md transition-all shadow-[0_0_15px_rgba(0,0,0,0.3)] hover:shadow-[0_0_15px_rgba(56,189,248,0.25)] group"
        >
          <svg class="w-4 h-4 text-sky-400 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Volver a la página principal</span>
        </a>
      </div>

      {/* Evaluación de Capacidades: flujo de 5 pasos que se ejecuta en el cliente */}
      <CapacidadesApp client:only="react" />
    </div>
  </main>
  
  <Footer />
</Layout>