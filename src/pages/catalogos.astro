---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Catálogos Rápidos - Pegasus Nexus | Tu Catálogo Digital en Minutos"
  description="Crea tu catálogo digital profesional con Catálogos Rápidos de Pegasus Nexus. Planes Básico, Profesional y Empresarial. Sin complicaciones, 100% online."
>
  <Header />

  <main class="relative bg-cosmos-dark text-white overflow-hidden">

    <!-- =========================================================================
         HERO - PORTADA CATÁLOGOS RÁPIDOS
         ========================================================================= -->
    <section class="relative min-h-[500px] lg:min-h-[560px] flex flex-col pt-28 lg:pt-32 pb-10 overflow-hidden bg-cosmos-dark">

      <!-- Fondo Cósmico -->
      <div class="hero-bg-cosmos absolute top-0 inset-x-0 h-[460px] lg:h-full lg:inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="hero-cosmos-image w-full h-full"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-cosmos-dark via-cosmos-dark/70 to-transparent pointer-events-none lg:hidden"></div>
      </div>

      <!-- Estrellas fugaces -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="shooting-star" style="top: 10%; left: -10%; animation-delay: 0s; animation-duration: 15s;"></div>
        <div class="shooting-star" style="top: 35%; left: 40%; animation-delay: 4s; animation-duration: 12s;"></div>
        <div class="meteorite" style="top: 8%; left: 12%; animation-delay: 2s; animation-duration: 3s;"></div>
        <div class="meteorite" style="top: 28%; left: 55%; animation-delay: 5s; animation-duration: 4s;"></div>
        <div class="meteorite" style="top: 65%; left: 80%; animation-delay: 3s; animation-duration: 2.8s;"></div>
      </div>

      <!-- Degradado inferior -->
      <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-cosmos-dark to-transparent pointer-events-none z-0"></div>

      <!-- Watermark lateral -->
      <div class="hidden xl:flex absolute left-8 top-1/2 -translate-y-1/2 flex-col items-center select-none pointer-events-none z-20">
        <div class="w-px h-20 bg-white/25"></div>
        <span class="text-[9px] uppercase tracking-[0.35em] text-gray-400 font-montserrat font-light whitespace-nowrap -rotate-90 origin-center my-16">
          CATÁLOGOS DIGITALES
        </span>
        <div class="w-px h-20 bg-white/25"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex-grow flex flex-col justify-between pt-2 lg:pt-4">

        <!-- Botón volver -->
        <div class="mb-5">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-slate-300 hover:text-white transition-colors duration-200 group cursor-pointer text-sm font-medium select-none"
          >
            <svg
              class="w-4 h-4 text-sky-400 group-hover:text-sky-300 group-hover:-translate-x-1.5 transition-all duration-200"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-linejoin="round"
            >
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span class="tracking-wide">Volver</span>
          </a>
        </div>

        <!-- Contenido Hero -->
        <div class="hero-content-block text-center lg:text-left w-full max-w-3xl flex flex-col items-center lg:items-start relative mb-4">

          <!-- Difuminado de texto -->
          <div class="absolute -inset-4 sm:-inset-6 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.65)_0%,rgba(0,0,0,0.25)_50%,transparent_75%)] blur-xl -z-10 pointer-events-none"></div>

          <!-- Badge -->
          <div class="w-full flex items-center justify-center lg:justify-start gap-2.5 lg:gap-3 mb-3 select-none">
            <div class="w-8 lg:w-12 h-[1.5px] bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)]"></div>
            <h2 class="text-sky-300 font-bold tracking-[0.25em] lg:tracking-[0.3em] uppercase text-[10px] lg:text-sm font-montserrat drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
              NUEVO SERVICIO · PEGASUS NEXUS
            </h2>
            <div class="w-8 h-[1.5px] bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)] lg:hidden"></div>
          </div>

          <!-- Título principal -->
          <h1 class="pn-title w-full mb-3" aria-label="Catálogos Rápidos">
            <span class="pn-pegasus">CATÁLOGOS</span>
            <span class="pn-nexus">RÁPIDOS</span>
          </h1>

          <!-- Subtítulo -->
          <h3 class="w-full text-center lg:text-left text-[23px] sm:text-3xl lg:text-[38px] font-bold text-white mb-3 tracking-tight leading-[1.2] lg:leading-[1.15] font-montserrat drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
            Tu catálogo digital,<br/>
            <span class="text-sky-400 drop-shadow-[0_0_20px_rgba(56,189,248,0.4)]">listo en minutos.</span>
          </h3>

          <!-- Descripción -->
          <p class="w-full text-center lg:text-left text-xs lg:text-sm text-gray-200 font-montserrat font-light leading-relaxed max-w-2xl mb-5 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">
            Muestra tus productos de forma profesional con un catálogo digital rápido, atractivo y fácil de compartir. Sin tecnicismos, sin complicaciones — solo resultados.
          </p>

          <!-- Insignias de valor -->
          <div class="w-full flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-montserrat pt-1">
            <div class="inline-flex items-center gap-1.5 text-sky-300">
              <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
              <span class="text-gray-200">Activación inmediata</span>
            </div>
            <div class="inline-flex items-center gap-1.5 text-sky-300">
              <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                <path d="M12 18h.01"/>
              </svg>
              <span class="text-gray-200">Optimizado para móviles</span>
            </div>
            <div class="inline-flex items-center gap-1.5 text-sky-300">
              <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span class="text-gray-200">Sin conocimientos técnicos</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         ¿QUÉ ES UN CATÁLOGO RÁPIDO?  (mini sección explicativa)
         ========================================================================= -->
    <section class="py-14 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(14,165,233,0.05),transparent)] pointer-events-none"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- Característica 1 -->
          <div class="flex flex-col items-center md:items-start gap-3 p-6 rounded-2xl bg-white/[0.03] border border-white/[0.07] hover:border-sky-500/30 transition-colors duration-300">
            <div class="w-11 h-11 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                <line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
            </div>
            <div class="text-center md:text-left">
              <h4 class="text-white font-semibold text-sm mb-1">Muestra tus productos</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Presenta tu oferta con fotos, descripciones y precios de forma ordenada y visual.</p>
            </div>
          </div>

          <!-- Característica 2 -->
          <div class="flex flex-col items-center md:items-start gap-3 p-6 rounded-2xl bg-white/[0.03] border border-white/[0.07] hover:border-sky-500/30 transition-colors duration-300">
            <div class="w-11 h-11 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                <polyline points="16 6 12 2 8 6"/>
                <line x1="12" y1="2" x2="12" y2="15"/>
              </svg>
            </div>
            <div class="text-center md:text-left">
              <h4 class="text-white font-semibold text-sm mb-1">Comparte fácilmente</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Envía tu catálogo por WhatsApp, redes sociales o correo con un solo enlace.</p>
            </div>
          </div>

          <!-- Característica 3 -->
          <div class="flex flex-col items-center md:items-start gap-3 p-6 rounded-2xl bg-white/[0.03] border border-white/[0.07] hover:border-sky-500/30 transition-colors duration-300">
            <div class="w-11 h-11 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>
            <div class="text-center md:text-left">
              <h4 class="text-white font-semibold text-sm mb-1">Actualiza cuando quieras</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Modifica productos, precios y fotos en tiempo real desde cualquier dispositivo.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================================
         PLANES DE CATÁLOGOS RÁPIDOS
         ========================================================================= -->
    <section id="planes-catalogos" class="py-16 sm:py-20 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <!-- Luces ambientales -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(14,165,233,0.06),transparent)] pointer-events-none"></div>
      <div class="absolute bottom-0 inset-x-0 h-96 bg-[radial-gradient(ellipse_100%_50%_at_50%_120%,rgba(14,165,233,0.08),transparent)] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <!-- Encabezado sección -->
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="w-8 sm:w-12 h-px bg-gradient-to-r from-transparent to-sky-400"></div>
            <span class="text-sky-400 text-[10px] sm:text-xs font-bold tracking-[0.25em] uppercase">ELIGE TU PLAN</span>
            <div class="w-8 sm:w-12 h-px bg-gradient-to-l from-transparent to-sky-400"></div>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-normal font-heading text-white tracking-wide mb-4">
            Planes para <span class="italic text-sky-400">cada negocio</span>
          </h2>
          <p class="text-gray-300 text-xs sm:text-sm font-light leading-relaxed">
            Desde emprendedores hasta empresas con múltiples sucursales. Encuentra el plan ideal y empieza a vender más hoy mismo.
          </p>
        </div>

        <!-- GRILLA DE PLANES -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch max-w-6xl mx-auto mb-14">

          <!-- ═══ PLAN BÁSICO ═══ -->
          <div class="group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c]/80 border border-sky-500/20 backdrop-blur-md transition-all duration-500 hover:border-sky-400/50 hover:shadow-[0_15px_35px_rgba(14,165,233,0.18)] hover:-translate-y-1.5">
            <div>
              <!-- Tag -->
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 group-hover:border-sky-400 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.3)] transition-all">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                    <line x1="4" y1="22" x2="4" y2="15"/>
                  </svg>
                </div>
                <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-gray-400 group-hover:text-sky-400 transition-colors">EMPRENDEDOR</span>
              </div>

              <h3 class="text-white font-heading font-semibold text-2xl mb-1 group-hover:text-sky-300 transition-colors">Plan Básico</h3>
              <p class="text-sky-400 text-xs font-medium mb-2">Para empezar a mostrar tus productos.</p>
              <p class="text-gray-400 text-xs font-light mb-6 leading-relaxed">Ideal para emprendedores y negocios pequeños que quieren su presencia digital sin complicaciones.</p>

              <!-- Precio -->
              <div class="mb-6">
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight">$0</span>
                  <span class="text-xs text-gray-400 font-light">USD / mes</span>
                </div>
                <div class="inline-flex items-center gap-1.5 mt-2.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px] font-medium">
                  <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Gratis para siempre</span>
                </div>
              </div>

              <!-- Límites clave -->
              <div class="mb-5 p-3.5 rounded-xl bg-sky-500/[0.06] border border-sky-500/15">
                <p class="text-[10px] text-sky-300 font-semibold uppercase tracking-widest mb-2.5">Límites del plan</p>
                <div class="space-y-1.5">
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Productos</span>
                    <span class="text-white font-semibold">hasta 15</span>
                  </div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Categorías</span>
                    <span class="text-white font-semibold">hasta 3</span>
                  </div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Fotos por producto</span>
                    <span class="text-white font-semibold">1 foto</span>
                  </div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Dominio personalizado</span>
                    <span class="text-red-400 font-semibold">No incluido</span>
                  </div>
                </div>
              </div>

              <!-- Features -->
              <ul class="space-y-3 mb-6 pt-1">
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Catálogo online con enlace para compartir.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Botón de contacto por WhatsApp.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Diseño responsivo (móvil y escritorio).</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Actualización de productos en tiempo real.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-500 font-light">
                  <svg class="w-4 h-4 text-gray-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  <span>Sin analíticas ni estadísticas de visitas.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-500 font-light">
                  <svg class="w-4 h-4 text-gray-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  <span>Sin logo ni colores de tu marca.</span>
                </li>
              </ul>
            </div>

            <a
              href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20interesa%20el%20Plan%20B%C3%A1sico%20de%20Cat%C3%A1logos%20R%C3%A1pidos."
              target="_blank" rel="noopener noreferrer"
              class="w-full py-3.5 px-4 rounded-xl border border-sky-500/30 text-sky-300 hover:text-white hover:bg-sky-500/20 hover:border-sky-400 transition-all text-center text-xs font-bold tracking-[0.14em] uppercase flex items-center justify-center gap-2 group-hover:border-sky-400 cursor-pointer"
            >
              <span>COMENZAR GRATIS</span>
              <span class="text-sm">→</span>
            </a>
          </div>

          <!-- ═══ PLAN PROFESIONAL (DESTACADO) ═══ -->
          <div class="group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c] border-2 border-sky-400 shadow-[0_0_35px_rgba(14,165,233,0.25)] backdrop-blur-md transition-all duration-500 hover:shadow-[0_0_50px_rgba(56,189,248,0.35)] hover:-translate-y-2">
            <!-- Glow superior -->
            <div class="absolute -top-10 -right-10 w-44 h-44 bg-sky-500/20 blur-3xl rounded-full pointer-events-none"></div>

            <div>
              <!-- Tag + Badge -->
              <div class="flex items-center justify-between gap-2 mb-6">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-sky-500/20 border border-sky-400 flex items-center justify-center text-sky-300 shadow-[0_0_15px_rgba(56,189,248,0.4)]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                      <polyline points="2 17 12 22 22 17"></polyline>
                      <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                  </div>
                  <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-sky-400">RECOMENDADO</span>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-sky-500/20 border border-sky-400 text-sky-300 text-[9px] font-bold uppercase tracking-wider shadow-[0_0_10px_rgba(56,189,248,0.3)]">
                  MÁS ELEGIDO
                </span>
              </div>

              <h3 class="text-white font-heading font-semibold text-2xl mb-1 text-glow">Plan Profesional</h3>
              <p class="text-sky-300 text-xs font-medium mb-2">Tu marca, tu estilo, tus ventas.</p>
              <p class="text-gray-300 text-xs font-light mb-6 leading-relaxed">Para negocios establecidos que necesitan un catálogo completo, con identidad de marca y herramientas de seguimiento.</p>

              <!-- Precio -->
              <div class="mb-6">
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight">$12</span>
                  <span class="text-xs text-gray-400 font-light">USD / mes</span>
                </div>
                <div class="text-[11px] text-sky-400 mt-1 font-medium">O $115 USD al año (ahorra ~20%)</div>
                <div class="inline-flex items-center gap-1.5 mt-2.5 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-400/30 text-sky-300 text-[11px] font-medium">
                  <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>14 días de prueba gratuita</span>
                </div>
              </div>

              <!-- Límites clave -->
              <div class="mb-5 p-3.5 rounded-xl bg-sky-500/[0.08] border border-sky-400/20">
                <p class="text-[10px] text-sky-300 font-semibold uppercase tracking-widest mb-2.5">Límites del plan</p>
                <div class="space-y-1.5">
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Productos</span>
                    <span class="text-white font-semibold">hasta 150</span>
                  </div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Categorías</span>
                    <span class="text-white font-semibold">hasta 15</span>
                  </div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Fotos por producto</span>
                    <span class="text-white font-semibold">hasta 5</span>
                  </div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-gray-400">Dominio personalizado</span>
                    <span class="text-sky-300 font-semibold">Incluido</span>
                  </div>
                </div>
              </div>

              <!-- Features -->
              <ul class="space-y-3 mb-6 pt-1">
                <li class="flex items-start gap-3 text-xs text-sky-200 font-medium">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Todo lo del Plan Básico.</span>
