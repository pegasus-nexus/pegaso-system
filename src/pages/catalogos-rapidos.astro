---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const AUTH_URL = 'https://app.pegasus-nexus.com/catalogo/auth?mode=login';
const REGISTER_URL = 'https://app.pegasus-nexus.com/catalogo/auth?mode=register';
const WA_URL = 'https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Me%20interesa%20el%20servicio%20de%20Cat%C3%A1logos%20R%C3%A1pidos.';
---

<Layout
  title="Catálogos Rápidos Gratis - Pegasus Nexus | Tu Catálogo Digital en Minutos"
  description="Crea tu catálogo digital gratis con Pegasus Nexus. Hasta 20 productos, listo en minutos, sin conocimientos técnicos. Comparte tu catálogo por WhatsApp y redes sociales."
>
  <Header />

  <main class="relative bg-cosmos-dark text-white overflow-hidden">

    <!-- =========================================================
         HERO - PORTADA PRINCIPAL
         ========================================================= -->
    <section class="relative min-h-screen flex flex-col justify-center pt-24 pb-16 overflow-hidden bg-cosmos-dark">

      <!-- Fondo cósmico -->
      <div class="hero-bg-cosmos absolute top-0 inset-x-0 h-full inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="hero-cosmos-image w-full h-full"></div>
      </div>

      <!-- Overlay degradado -->
      <div class="absolute inset-0 bg-gradient-to-b from-cosmos-dark/40 via-transparent to-cosmos-dark pointer-events-none z-0"></div>

      <!-- Estrellas fugaces decorativas -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="shooting-star" style="top: 8%; left: -10%; animation-delay: 0s; animation-duration: 14s;"></div>
        <div class="shooting-star" style="top: 30%; left: 20%; animation-delay: 3s; animation-duration: 11s;"></div>
        <div class="shooting-star" style="top: 60%; left: 60%; animation-delay: 6s; animation-duration: 13s;"></div>
        <div class="meteorite" style="top: 15%; left: 20%; animation-delay: 1s; animation-duration: 3.5s;"></div>
        <div class="meteorite" style="top: 45%; left: 70%; animation-delay: 4s; animation-duration: 2.8s;"></div>
      </div>

      <!-- Luces ambientales -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-sky-500/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">

        <!-- Badge "Nuevo servicio" -->
        <div class="flex justify-center mb-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/30 backdrop-blur-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shadow-[0_0_6px_#38bdf8] animate-pulse"></span>
            <span class="text-sky-300 text-[11px] font-bold uppercase tracking-[0.2em]">Nuevo servicio · Completamente Gratis</span>
          </div>
        </div>

        <!-- Título principal centrado -->
        <div class="text-center mb-6">
          <h1 class="pn-title mb-4" aria-label="Catálogos Rápidos">
            <span class="pn-pegasus">CATÁLOGOS</span>
            <span class="pn-nexus">RÁPIDOS</span>
          </h1>

          <h2 class="text-2xl sm:text-3xl lg:text-5xl font-bold text-white tracking-tight leading-tight font-montserrat max-w-3xl mx-auto mb-5">
            Tu catálogo digital,<br/>
            <span class="text-sky-400 drop-shadow-[0_0_20px_rgba(56,189,248,0.4)]">listo en minutos. Gratis.</span>
          </h2>

          <p class="text-sm sm:text-base text-gray-300 font-light leading-relaxed max-w-2xl mx-auto mb-8">
            Muestra tus productos de forma profesional, compártelos por WhatsApp y redes sociales, y empieza a recibir consultas hoy mismo. Sin complicaciones técnicas.
          </p>

          <!-- CTAs principales -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
            <a
              href={REGISTER_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-sm tracking-wider uppercase shadow-[0_0_30px_rgba(14,165,233,0.5)] hover:shadow-[0_0_45px_rgba(56,189,248,0.7)] transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
              <span>Crear mi catálogo gratis</span>
            </a>
            <a
              href={AUTH_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-4 rounded-full border border-white/20 bg-white/5 hover:bg-white/10 hover:border-white/40 text-white font-semibold text-sm tracking-wide transition-all duration-300 cursor-pointer"
            >
              <span>Ya tengo cuenta →</span>
            </a>
          </div>

          <!-- Micro-garantías -->
          <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-gray-400">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Sin tarjeta de crédito
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Activación inmediata
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Siempre gratuito (con opción a mejorar)
            </span>
          </div>
        </div>

        <!-- MOCKUP VISUAL: cómo quedaría el catálogo -->
        <div class="max-w-4xl mx-auto mt-12">
          <div class="relative">
            <!-- Glow de fondo -->
            <div class="absolute -inset-4 bg-sky-500/10 blur-3xl rounded-3xl pointer-events-none"></div>

            <!-- Contenedor del mockup tipo "browser" -->
            <div class="relative rounded-2xl overflow-hidden border border-sky-500/20 shadow-[0_0_60px_rgba(14,165,233,0.15)] bg-[#070e1c]/90 backdrop-blur-xl">

              <!-- Barra de navegador falsa -->
              <div class="flex items-center gap-2 px-4 py-3 bg-[#040a15] border-b border-white/[0.06]">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
                </div>
                <div class="flex-1 mx-3">
                  <div class="bg-white/[0.06] border border-white/[0.08] rounded-md px-3 py-1.5 text-[11px] text-gray-400 font-mono flex items-center gap-2">
                    <svg class="w-3 h-3 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    catalogo.pegasus-nexus.com/<span class="text-sky-300">tu-negocio</span>
                  </div>
                </div>
              </div>

              <!-- Contenido del mockup: catálogo de ejemplo -->
              <div class="p-5 sm:p-6">
                <!-- Header del catálogo de ejemplo -->
                <div class="flex items-center justify-between mb-5 pb-4 border-b border-white/[0.06]">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/20 border border-sky-400/30 flex items-center justify-center text-sky-300 font-bold text-sm font-montserrat">TN</div>
                    <div>
                      <p class="text-white font-semibold text-sm">Tu Negocio</p>
                      <p class="text-gray-400 text-[11px]">Catálogo Digital · 20 productos</p>
                    </div>
                  </div>
                  <a class="flex items-center gap-1.5 text-[11px] text-emerald-300 bg-emerald-500/10 border border-emerald-500/25 px-3 py-1.5 rounded-full font-medium cursor-default">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.86L0 24l6.302-1.654A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.015-1.372l-.359-.214-3.733.979 1-3.635-.234-.374A9.808 9.808 0 012.182 12C2.182 6.566 6.566 2.182 12 2.182S21.818 6.566 21.818 12 17.434 21.818 12 21.818z"/></svg>
                    Consultar
                  </a>
                </div>

                <!-- Grid de productos de ejemplo -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  {[
                    { name: 'Producto 01', price: '$25.00', emoji: '👟' },
                    { name: 'Producto 02', price: '$18.50', emoji: '👕' },
                    { name: 'Producto 03', price: '$42.00', emoji: '👜' },
                    { name: 'Producto 04', price: '$12.00', emoji: '🕶️' },
                  ].map((p) => (
                    <div class="rounded-xl bg-white/[0.04] border border-white/[0.07] overflow-hidden hover:border-sky-500/30 transition-colors group/p">
                      <div class="aspect-square bg-gradient-to-br from-sky-500/10 to-blue-600/10 flex items-center justify-center text-3xl sm:text-4xl">
                        {p.emoji}
                      </div>
                      <div class="p-2.5">
                        <p class="text-white text-[11px] font-medium truncate">{p.name}</p>
                        <p class="text-sky-400 text-[11px] font-bold mt-0.5">{p.price}</p>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Pie del mockup -->
                <div class="mt-4 pt-3 border-t border-white/[0.05] flex items-center justify-between">
                  <p class="text-[10px] text-gray-500">Mostrando 4 de 20 productos</p>
                  <p class="text-[10px] text-sky-400/60 font-mono">powered by Pegasus Nexus</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================
         ¿EN QUÉ CONSISTE? - BREVE Y DIRECTO
         ========================================================= -->
    <section class="py-16 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_0%,rgba(14,165,233,0.05),transparent)] pointer-events-none"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <!-- Encabezado -->
        <div class="text-center mb-12">
          <div class="flex items-center justify-center gap-3 mb-3">
            <div class="w-8 h-px bg-gradient-to-r from-transparent to-sky-400"></div>
            <span class="text-sky-400 text-[10px] font-bold tracking-[0.25em] uppercase">¿En qué consiste?</span>
            <div class="w-8 h-px bg-gradient-to-l from-transparent to-sky-400"></div>
          </div>
          <h2 class="text-3xl sm:text-4xl font-normal font-heading text-white tracking-wide mb-3">
            Simple, rápido y <span class="italic text-sky-400">completamente gratis</span>
          </h2>
          <p class="text-gray-400 text-sm font-light max-w-xl mx-auto leading-relaxed">
            Un catálogo digital es tu vitrina en internet. Tus clientes pueden verlo desde su celular, consultar por WhatsApp y hacer pedidos en segundos.
          </p>
        </div>

        <!-- 3 columnas: qué es / cuánto dura / cómo queda -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

          <!-- QUÉ ES -->
          <div class="relative rounded-2xl p-6 bg-[#070e1c]/80 border border-sky-500/15 hover:border-sky-500/35 transition-all duration-300 group">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-4 group-hover:border-sky-400/50 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                <line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono text-sky-400 tracking-[0.2em] uppercase mb-2">01 · QUÉ ES</div>
            <h3 class="text-white font-semibold text-base mb-2">Tu catálogo online</h3>
            <p class="text-gray-400 text-xs font-light leading-relaxed">
              Una página web con todos tus productos, precios y fotos. Lista para compartir por WhatsApp, Instagram, Facebook o donde quieras.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.06]">
              <p class="text-sky-300 text-[11px] font-medium">Hasta 20 productos · 1 foto cada uno</p>
            </div>
          </div>

          <!-- CUÁNTO DURA -->
          <div class="relative rounded-2xl p-6 bg-[#070e1c]/80 border border-sky-500/15 hover:border-sky-500/35 transition-all duration-300 group">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-4 group-hover:border-sky-400/50 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono text-sky-400 tracking-[0.2em] uppercase mb-2">02 · DURACIÓN</div>
            <h3 class="text-white font-semibold text-base mb-2">Gratis para siempre</h3>
            <p class="text-gray-400 text-xs font-light leading-relaxed">
              El plan gratuito no vence ni caduca. Puedes usarlo indefinidamente. Cuando tu negocio crezca, tienes la opción de mejorar tu plan.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.06]">
              <p class="text-emerald-300 text-[11px] font-medium">Sin límite de tiempo · Sin vencimiento</p>
            </div>
          </div>

          <!-- CÓMO QUEDA -->
          <div class="relative rounded-2xl p-6 bg-[#070e1c]/80 border border-sky-500/15 hover:border-sky-500/35 transition-all duration-300 group">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-4 group-hover:border-sky-400/50 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                <path d="M12 18h.01"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono text-sky-400 tracking-[0.2em] uppercase mb-2">03 · CÓMO QUEDA</div>
            <h3 class="text-white font-semibold text-base mb-2">Profesional y en tu celular</h3>
            <p class="text-gray-400 text-xs font-light leading-relaxed">
              Diseño moderno, carga rápida y adaptado para verse perfecto en cualquier dispositivo. Tus clientes lo abrirán directo desde WhatsApp.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.06]">
              <p class="text-sky-300 text-[11px] font-medium">Móvil · Escritorio · Tablet</p>
            </div>
          </div>
        </div>

        <!-- CTA intermedio -->
        <div class="text-center">
          <a
            href={REGISTER_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-sky-500/10 border border-sky-400/40 text-sky-300 hover:text-white hover:bg-sky-500/20 hover:border-sky-400 font-bold text-xs tracking-[0.15em] uppercase transition-all duration-300 cursor-pointer"
          >
            <span>Empezar ahora — es gratis</span>
            <span class="text-base">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================================
         VENTAJAS / BENEFICIOS
         ========================================================= -->
    <section class="py-16 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <div class="absolute bottom-0 inset-x-0 h-80 bg-[radial-gradient(ellipse_80%_50%_at_50%_120%,rgba(14,165,233,0.06),transparent)] pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <div class="text-center mb-12">
          <div class="flex items-center justify-center gap-3 mb-3">
            <div class="w-8 h-px bg-gradient-to-r from-transparent to-sky-400"></div>
            <span class="text-sky-400 text-[10px] font-bold tracking-[0.25em] uppercase">Ventajas</span>
            <div class="w-8 h-px bg-gradient-to-l from-transparent to-sky-400"></div>
          </div>
          <h2 class="text-3xl sm:text-4xl font-normal font-heading text-white tracking-wide mb-3">
            ¿Por qué <span class="italic text-sky-400">Catálogos Rápidos</span>?
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

          <!-- Ventaja 1 -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-sky-500/25 hover:bg-white/[0.05] transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0 mt-0.5 group-hover:border-sky-400/50 transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm mb-1.5">Listo en minutos</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Regístrate, carga tus productos con foto y precio, y tu catálogo ya está en línea. Sin esperas, sin formularios largos.</p>
            </div>
          </div>

          <!-- Ventaja 2 -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-sky-500/25 hover:bg-white/[0.05] transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0 mt-0.5 group-hover:border-sky-400/50 transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                <polyline points="16 6 12 2 8 6"/>
                <line x1="12" y1="2" x2="12" y2="15"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm mb-1.5">Fácil de compartir</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Un solo enlace para compartir por WhatsApp, Instagram, Facebook, correo o donde prefieras. Tus clientes lo abren al instante.</p>
            </div>
          </div>

          <!-- Ventaja 3 -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-sky-500/25 hover:bg-white/[0.05] transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0 mt-0.5 group-hover:border-sky-400/50 transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm mb-1.5">Actualízalo cuando quieras</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">¿Cambió el precio? ¿Nuevo producto? Edita tu catálogo en segundos y todos tus clientes ven los cambios al instante.</p>
            </div>
          </div>

          <!-- Ventaja 4 -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-sky-500/25 hover:bg-white/[0.05] transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0 mt-0.5 group-hover:border-sky-400/50 transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <rect x="5" y="2" width="14" height="20" rx="2"/>
                <path d="M12 18h.01"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm mb-1.5">100% desde tu celular</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Gestiona tu catálogo desde donde estés. No necesitas computadora, no necesitas instalar nada.</p>
            </div>
          </div>

          <!-- Ventaja 5 -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-sky-500/25 hover:bg-white/[0.05] transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0 mt-0.5 group-hover:border-sky-400/50 transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm mb-1.5">Sin riesgos ni compromisos</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">El plan gratuito no vence. No te pedimos tarjeta. No hay letra pequeña. Si decides mejorar tu plan, es cuando tú quieras.</p>
            </div>
          </div>

          <!-- Ventaja 6 -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-sky-500/25 hover:bg-white/[0.05] transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0 mt-0.5 group-hover:border-sky-400/50 transition-all">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <line x1="12" y1="20" x2="12" y2="10"/>
                <line x1="18" y1="20" x2="18" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="16"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm mb-1.5">Crece cuando tú crezcas</h4>
              <p class="text-gray-400 text-xs font-light leading-relaxed">Cuando necesites más productos, fotos, dominio propio o analíticas, tienes planes de upgrade disponibles en un clic.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================
         COMPARATIVA: GRATIS vs UPGRADE
         ========================================================= -->
    <section class="py-16 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(14,165,233,0.04),transparent)] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-normal font-heading text-white tracking-wide mb-2">
            Empieza gratis, <span class="italic text-sky-400">mejora cuando quieras</span>
          </h2>
          <p class="text-gray-400 text-xs font-light">No estás limitado para siempre — crece a tu ritmo.</p>
        </div>

        <!-- Tabla comparativa -->
        <div class="rounded-2xl overflow-hidden border border-white/[0.07] shadow-[0_0_30px_rgba(0,0,0,0.5)]">
          <div class="grid grid-cols-3 bg-[#040a15] border-b border-white/[0.07]">
            <div class="px-5 py-4 text-xs text-gray-500 font-medium">Qué incluye</div>
            <div class="px-4 py-4 text-center">
              <span class="text-xs font-bold text-white">Plan Gratis</span>
              <div class="text-[10px] text-emerald-400 mt-0.5">Sin costo · Siempre</div>
            </div>
            <div class="px-4 py-4 text-center border-l border-sky-400/20 bg-sky-500/[0.04]">
              <span class="text-xs font-bold text-sky-300">Upgrade</span>
              <div class="text-[10px] text-sky-400/70 mt-0.5">Cuando tú quieras</div>
            </div>
          </div>

          {[
            { label: 'Productos', free: 'hasta 20', upgrade: 'hasta 150+' },
            { label: 'Fotos por producto', free: '1 foto', upgrade: 'hasta 5 fotos' },
            { label: 'Categorías', free: 'hasta 3', upgrade: 'hasta 15+' },
            { label: 'Botón WhatsApp', free: '✓', upgrade: '✓' },
            { label: 'Enlace para compartir', free: '✓', upgrade: '✓' },
            { label: 'Dominio personalizado', free: '—', upgrade: '✓' },
            { label: 'Logo y colores de marca', free: '—', upgrade: '✓' },
            { label: 'Búsqueda y filtros', free: '—', upgrade: '✓' },
            { label: 'Analíticas de visitas', free: '—', upgrade: '✓' },
          ].map((row, i) => (
            <div class={`grid grid-cols-3 border-b border-white/[0.05] ${i % 2 === 0 ? '' : 'bg-white/[0.015]'}`}>
              <div class="px-5 py-3 text-xs text-gray-400">{row.label}</div>
              <div class="px-4 py-3 text-center text-xs text-gray-300 font-medium">{row.free}</div>
              <div class="px-4 py-3 text-center text-xs text-sky-300 font-medium border-l border-sky-400/10 bg-sky-500/[0.03]">{row.upgrade}</div>
            </div>
          ))}

          <!-- Fila de precios -->
          <div class="grid grid-cols-3 bg-[#040a15]">
            <div class="px-5 py-4 text-xs text-gray-500 font-medium">Precio</div>
            <div class="px-4 py-4 text-center">
              <span class="text-lg font-bold text-white">$0</span>
              <span class="text-xs text-gray-400 ml-1">/ mes</span>
            </div>
            <div class="px-4 py-4 text-center border-l border-sky-400/20 bg-sky-500/[0.04]">
              <span class="text-lg font-bold text-sky-300">desde $12</span>
              <span class="text-xs text-gray-400 ml-1">/ mes</span>
            </div>
          </div>
        </div>

        <!-- Ver todos los planes -->
        <div class="text-center mt-6">
          <a
            href="/catalogos"
            class="text-xs text-sky-400 hover:text-sky-300 underline underline-offset-4 decoration-sky-400/40 hover:decoration-sky-300 transition-colors cursor-pointer"
          >
            Ver todos los planes y precios →
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================================
         CTA FINAL — REGISTRO / INICIO DE SESIÓN
         ========================================================= -->
    <section class="py-20 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <!-- Luces de fondo -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_50%,rgba(14,165,233,0.07),transparent)] pointer-events-none"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-transparent to-sky-400/40 pointer-events-none"></div>

      <div class="max-w-lg mx-auto px-4 sm:px-6 relative z-10">

        <!-- Encabezado CTA -->
        <div class="text-center mb-10">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-sky-500/10 border border-sky-400/30 mb-5 shadow-[0_0_30px_rgba(56,189,248,0.15)]">
            <svg class="w-7 h-7 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
              <line x1="4" y1="22" x2="4" y2="15"/>
            </svg>
          </div>
          <h2 class="text-3xl sm:text-4xl font-normal font-heading text-white tracking-wide mb-3">
            Comenzar ahora
          </h2>
          <p class="text-gray-400 text-sm font-light leading-relaxed">
            Crea tu cuenta gratis y ten tu catálogo en línea en menos de 5 minutos. Sin tarjeta, sin complicaciones.
          </p>
        </div>

        <!-- Tarjeta del CTA con opciones -->
        <div class="rounded-3xl p-8 bg-[#070e1c]/90 border border-sky-400/20 shadow-[0_0_60px_rgba(14,165,233,0.12)] backdrop-blur-xl">

          <!-- Botón principal: Crear cuenta -->
          <a
            href={REGISTER_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-3 py-4 px-6 rounded-2xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-sm tracking-wider uppercase shadow-[0_0_25px_rgba(14,165,233,0.5)] hover:shadow-[0_0_40px_rgba(56,189,248,0.7)] transition-all duration-300 hover:-translate-y-0.5 cursor-pointer mb-4"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
            <span>Crear mi cuenta gratis</span>
          </a>

          <!-- Separador -->
          <div class="flex items-center gap-3 my-5">
            <div class="flex-1 h-px bg-white/[0.07]"></div>
            <span class="text-[11px] text-gray-500">¿Ya tienes cuenta?</span>
            <div class="flex-1 h-px bg-white/[0.07]"></div>
          </div>

          <!-- Botón secundario: Iniciar sesión -->
          <a
            href={AUTH_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2.5 py-3.5 px-6 rounded-2xl border border-sky-500/30 text-sky-300 hover:text-white hover:bg-sky-500/15 hover:border-sky-400 transition-all duration-300 cursor-pointer text-sm font-semibold tracking-wide"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
              <polyline points="10 17 15 12 10 7"/>
              <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
            <span>Iniciar sesión</span>
          </a>

          <!-- Qué datos piden (referencia visual) -->
          <div class="mt-6 pt-5 border-t border-white/[0.06]">
            <p class="text-[11px] text-gray-500 text-center mb-3 uppercase tracking-wider">Al registrarte necesitarás</p>
            <div class="grid grid-cols-3 gap-2 text-center">
              <div class="rounded-xl py-2.5 px-2 bg-white/[0.03] border border-white/[0.06]">
                <svg class="w-4 h-4 text-sky-400 mx-auto mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                <p class="text-[10px] text-gray-400">Nombre del negocio</p>
              </div>
              <div class="rounded-xl py-2.5 px-2 bg-white/[0.03] border border-white/[0.06]">
                <svg class="w-4 h-4 text-sky-400 mx-auto mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
                <p class="text-[10px] text-gray-400">Correo electrónico</p>
              </div>
              <div class="rounded-xl py-2.5 px-2 bg-white/[0.03] border border-white/[0.06]">
                <svg class="w-4 h-4 text-sky-400 mx-auto mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <p class="text-[10px] text-gray-400">Contraseña</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Garantía final -->
        <p class="text-center text-xs text-gray-500 mt-5 leading-relaxed">
          🔒 Tu información está segura. No compartimos tus datos con nadie.<br/>
          Puedes eliminar tu cuenta cuando quieras.
        </p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
