---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Planes de Solución - Pegasus Nexus | Arquitecturas Digitales a tu Medida"
  description="Conoce nuestros planes de solución digital: Plan Gratis, Plan Estándar y Plan Personalizado. Elige la solución ideal y comienza con prueba gratuita."
>
  <Header />

  <main class="relative bg-cosmos-dark text-white overflow-hidden">
    
    <!-- =========================================================================
         PORTADA HERO DE PLANES (Con la misma estética cósmica de la portada principal)
         ========================================================================= -->
    <section class="relative min-h-[500px] lg:min-h-[560px] flex flex-col pt-28 lg:pt-32 pb-10 overflow-hidden bg-cosmos-dark">
      
      <!-- Fondo Cósmico idéntico a la portada -->
      <div class="hero-bg-cosmos absolute top-0 inset-x-0 h-[460px] lg:h-full lg:inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="hero-cosmos-image w-full h-full"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-cosmos-dark via-cosmos-dark/70 to-transparent pointer-events-none lg:hidden"></div>
      </div>

      <!-- Lluvia de meteoritos y estrellas fugaces -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="shooting-star" style="top: 10%; left: -10%; animation-delay: 0s; animation-duration: 15s;"></div>
        <div class="shooting-star" style="top: 35%; left: 40%; animation-delay: 4s; animation-duration: 12s;"></div>
        <div class="meteorite" style="top: 8%; left: 12%; animation-delay: 2s; animation-duration: 3s;"></div>
        <div class="meteorite" style="top: 28%; left: 55%; animation-delay: 5s; animation-duration: 4s;"></div>
        <div class="meteorite" style="top: 65%; left: 80%; animation-delay: 3s; animation-duration: 2.8s;"></div>
      </div>

      <!-- Suavizado hacia el fondo oscuro -->
      <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-cosmos-dark to-transparent pointer-events-none z-0"></div>

      <!-- Watermark vertical lateral izquierdo -->
      <div class="hidden xl:flex absolute left-8 top-1/2 -translate-y-1/2 flex-col items-center select-none pointer-events-none z-20">
        <div class="w-px h-20 bg-white/25"></div>
        <span class="text-[9px] uppercase tracking-[0.35em] text-gray-400 font-montserrat font-light whitespace-nowrap -rotate-90 origin-center my-16">
          UN MUNDO DE POSIBILIDADES
        </span>
        <div class="w-px h-20 bg-white/25"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex-grow flex flex-col justify-between pt-2 lg:pt-4">
        
        <!-- Botón para volver a la página principal -->
        <div class="mb-5">
          <a 
            href="/" 
            class="inline-flex items-center gap-2 text-slate-300 hover:text-white transition-colors duration-200 group cursor-pointer text-sm font-medium select-none"
          >
            <svg 
              class="w-4 h-4 text-sky-400 group-hover:text-sky-300 group-hover:-translate-x-1.5 transition-all duration-200" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2.2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
            >
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span class="tracking-wide">Volver</span>
          </a>
        </div>

        <!-- Contenedor Principal de la Portada -->
        <div class="hero-content-block text-center lg:text-left w-full max-w-3xl flex flex-col items-center lg:items-start relative mb-4">
          
          <!-- Difuminado negro en el área de texto -->
          <div class="absolute -inset-4 sm:-inset-6 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.65)_0%,rgba(0,0,0,0.25)_50%,transparent_75%)] blur-xl -z-10 pointer-events-none"></div>

          <!-- Subtitle badge con acentos lineales -->
          <div class="w-full flex items-center justify-center lg:justify-start gap-2.5 lg:gap-3 mb-3 select-none">
            <div class="w-8 lg:w-12 h-[1.5px] bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)]"></div>
            <h2 class="text-sky-300 font-bold tracking-[0.25em] lg:tracking-[0.3em] uppercase text-[10px] lg:text-sm font-montserrat drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
              NUESTROS PLANOS DE SOLUCIÓN
            </h2>
            <div class="w-8 h-[1.5px] bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)] lg:hidden"></div>
          </div>

          <!-- Título PEGASUS PLANES idéntico a la portada -->
          <h1 class="pn-title w-full mb-3" aria-label="Pegasus Nexus Planes">
            <span class="pn-pegasus">PEGASUS</span>
            <span class="pn-nexus">PLANES</span>
          </h1>

          <!-- Punchline de la Propuesta de Valor -->
          <h3 class="w-full text-center lg:text-left text-[23px] sm:text-3xl lg:text-[40px] font-bold text-white mb-3 tracking-tight leading-[1.2] lg:leading-[1.15] font-montserrat drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
            Arquitecturas digitales <br />
            <span class="text-sky-400 drop-shadow-[0_0_20px_rgba(56,189,248,0.4)]">para cada etapa de tu crecimiento.</span>
          </h3>

          <!-- Párrafo descriptivo -->
          <p class="w-full text-center lg:text-left text-xs lg:text-sm text-gray-200 font-montserrat font-light leading-relaxed max-w-2xl mb-5 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">
            Soluciones flexibles y personalizables que se adaptan a tus objetivos, desde una presencia digital hasta ecosistemas empresariales completos. Elige el plan ideal y acelera el desarrollo de tu empresa.
          </p>

          <!-- Micro-insignias de valor -->
          <div class="w-full flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-montserrat pt-1">
            <div class="inline-flex items-center gap-1.5 text-sky-300">
              <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
              <span class="text-gray-200">Pruebas sin costo ni tarjeta requerida</span>
            </div>
            <div class="inline-flex items-center gap-1.5 text-sky-300">
              <svg class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span class="text-gray-200">Activación rápida y soporte en horario laboral</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECCIÓN PRINCIPAL DE PLANES Y PRECIOS
         ========================================================================= -->
    <section class="py-12 sm:py-16 relative overflow-hidden bg-cosmos-dark border-t border-white/[0.05]">
      <!-- Luces ambientales sutiles -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(14,165,233,0.06),transparent)] pointer-events-none"></div>
      <div class="absolute bottom-0 inset-x-0 h-96 bg-[radial-gradient(ellipse_100%_50%_at_50%_120%,rgba(14,165,233,0.08),transparent)] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Selector Mensual / Anual -->
        <div class="flex items-center justify-center gap-3 mb-14">
          <div class="inline-flex p-1 rounded-full bg-[#0a1528]/80 border border-sky-500/25 backdrop-blur-md">
            <button
              id="planes-monthly-btn"
              type="button"
              class="px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-white bg-sky-500/20 border border-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] cursor-pointer"
            >
              Facturación Mensual
            </button>
            <button
              id="planes-annual-btn"
              type="button"
              class="px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-gray-400 hover:text-white border border-transparent cursor-pointer flex items-center gap-2"
            >
              <span>Facturación Anual</span>
              <span class="text-[10px] text-sky-300 bg-sky-500/20 px-2 py-0.5 rounded-full border border-sky-400/30 font-bold">Ahorra ~20%</span>
            </button>
          </div>
        </div>

        <!-- Grilla de los 3 Planes (Plan Gratis, Plan Estándar, Plan Personalizado) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch mb-20 max-w-6xl mx-auto">
          
          <!-- 01. PLAN GRATIS -->
          <div class="group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c]/80 border border-sky-500/20 backdrop-blur-md transition-all duration-500 hover:border-sky-400/50 hover:shadow-[0_15px_35px_rgba(14,165,233,0.18)] hover:-translate-y-1.5">
            <div>
              <!-- Icono & Tag de Plan -->
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 group-hover:border-sky-400 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.3)] transition-all">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                </div>
                <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-gray-400 group-hover:text-sky-400 transition-colors">
                  INICIAL
                </span>
              </div>

              <h3 class="text-white font-heading font-semibold text-2xl mb-1 group-hover:text-sky-300 transition-colors">
                Plan Gratis
              </h3>
              
              <p class="text-sky-400 text-xs font-medium mb-3">
                Lo esencial para empezar.
              </p>

              <p class="text-gray-400 text-xs font-light mb-6 leading-relaxed">
                Para una persona que necesita organizar información sencilla de su negocio.
              </p>

              <!-- Bloque de Precio -->
              <div class="mb-6">
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight">$0.00</span>
                  <span class="text-xs text-gray-400 font-light">USD</span>
                </div>
                <div class="text-[11px] text-sky-400 mt-1 font-medium">
                  0.00 dólares por 30 días
                </div>
                <div class="inline-flex items-center gap-1.5 mt-2.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px] font-medium">
                  <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Gratis por 30 días</span>
                </div>
              </div>

              <!-- Lista de características -->
              <ul class="space-y-3.5 mb-8 pt-2">
                <li class="flex items-start gap-3 text-xs text-sky-300 font-medium">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Ingreso a todos los módulos que quieras.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Una aplicación básica: clientes o inventario.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Un solo usuario.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Registro, consulta y edición de información.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Acceso en línea sin costo por 30 días.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-300 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Guía de uso para comenzar.</span>
                </li>
              </ul>
            </div>

            <!-- Botón Quiero Empezar Ahora -->
            <a 
              href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Quiero%20empezar%20ahora%20con%20el%20Plan%20Gratis." 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-3.5 px-4 rounded-xl border border-sky-500/30 text-sky-300 hover:text-white hover:bg-sky-500/20 hover:border-sky-400 transition-all text-center text-xs font-bold tracking-[0.14em] uppercase flex items-center justify-center gap-2 group-hover:border-sky-400 cursor-pointer"
            >
              <span>QUIERO EMPEZAR AHORA</span>
              <span class="text-sm">→</span>
            </a>
          </div>

          <!-- 02. PLAN ESTÁNDAR (DESTACADO / RECOMENDADO) -->
          <div class="group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c] border-2 border-sky-400 shadow-[0_0_35px_rgba(14,165,233,0.25)] backdrop-blur-md transition-all duration-500 hover:shadow-[0_0_50px_rgba(56,189,248,0.35)] hover:-translate-y-2">
            <!-- Glow ambiental superior -->
            <div class="absolute -top-10 -right-10 w-44 h-44 bg-sky-500/20 blur-3xl rounded-full pointer-events-none"></div>

            <div>
              <!-- Icono, Tag de Plan y Badge "MÁS ELEGIDO" -->
              <div class="flex items-center justify-between gap-2 mb-6">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-sky-500/20 border border-sky-400 flex items-center justify-center text-sky-300 shadow-[0_0_15px_rgba(56,189,248,0.4)]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                      <polyline points="2 17 12 22 22 17"></polyline>
                      <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                  </div>
                  <span class="text-[10px] font-mono font-bold tracking-[0.18em] uppercase text-sky-400">
                    RECOMENDADO
                  </span>
                </div>

                <!-- Badge Más Elegido -->
                <span class="px-2.5 py-1 rounded-full bg-sky-500/20 border border-sky-400 text-sky-300 text-[9px] font-bold uppercase tracking-wider shadow-[0_0_10px_rgba(56,189,248,0.3)]">
                  MÁS ELEGIDO
                </span>
              </div>

              <h3 class="text-white font-heading font-semibold text-2xl mb-1 text-glow">
                Plan Estándar
              </h3>
              
              <p class="text-sky-300 text-xs font-medium mb-3">
                Gestiona las actividades diarias de tu negocio.
              </p>

              <p class="text-gray-300 text-xs font-light mb-6 leading-relaxed">
                Para negocios que necesitan conectar sus ventas, productos y clientes en un mismo sistema.
              </p>

              <!-- Bloque de Precio -->
              <div class="mb-6">
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight planes-price-monthly">$8.15</span>
                  <span class="text-4xl sm:text-5xl font-bold font-heading text-white tracking-tight planes-price-annual hidden">$6.52</span>
                  <span class="text-xs text-gray-400 font-light planes-cycle-text">USD / mes</span>
                </div>
                <div class="text-[11px] text-gray-400 mt-1 font-light">
                  <span>Mensual: <strong class="text-sky-300 font-medium">$8.15</strong> • Anual: <strong class="text-sky-300 font-medium">$6.52</strong>/mes</span>
                </div>
                <div class="inline-flex items-center gap-1.5 mt-2.5 px-3 py-1 rounded-full bg-sky-500/20 border border-sky-400/40 text-sky-300 text-[11px] font-medium shadow-[0_0_12px_rgba(56,189,248,0.25)]">
                  <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Gratis por 15 días</span>
                </div>
              </div>

              <!-- Lista de características -->
              <ul class="space-y-3.5 mb-6 pt-2">
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Todas las aplicaciones estándar disponibles.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Gestión de ventas, inventario y clientes.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Reportes para conocer los resultados del negocio.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Trabajo en equipo con usuarios y permisos.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Descarga de información.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Acceso en línea, actualizaciones y mantenimiento.</span>
                </li>
                <li class="flex items-start gap-3 text-xs text-gray-200 font-light">
                  <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Soporte en horario laboral.</span>
                </li>
              </ul>

              <!-- Logo Odoo con enlace directo a https://odoo.pegasus-nexus.com/ -->
              <a
                href="https://odoo.pegasus-nexus.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2.5 py-2.5 mb-6 hover:border-sky-400/40 transition-all group/odoo cursor-pointer rounded-lg bg-sky-500/[0.04]"
              >
                <img 
                  src="/logo-odoo.png" 
                  alt="Odoo Pegasus Nexus" 
                  class="h-5 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(169,76,146,0.6)] group-hover/odoo:scale-105 transition-transform" 
                />
                <span class="text-[10px] text-gray-300 group-hover/odoo:text-sky-300 font-montserrat flex items-center gap-1">
                  <span>odoo.pegasus-nexus.com</span>
                  <span class="text-sky-400">↗</span>
                </span>
              </a>
            </div>

            <!-- Botón Quiero Empezar Ahora -->
            <a 
              href="https://wa.me/59179786916?text=Hola%20Pegasus%20Nexus!%20Quiero%20empezar%20ahora%20con%20el%20Plan%20Est%C3%A1ndar." 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-xs tracking-[0.14em] uppercase shadow-[0_0_25px_rgba(14,165,233,0.7)] hover:shadow-[0_0_35px_rgba(56,189,248,0.9)] transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>QUIERO EMPEZAR AHORA</span>
              <span class="text-sm">→</span>
            </a>
          </div>

          <!-- 03. PLAN PERSONALIZADO -->
          <div class="group rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#070e1c]/80 border border-sky-500/20 backdrop-blur-md transition-all duration-500 hover:border-sky-400/50 hover:shadow-[0_15px_35px_rgba(14,165,233,0.18)] hover:-translate-y-1.5">
            <div>
              <!-- Icono & Tag de Plan -->
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 group-hover:border-sky-400 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.3)] transition-all">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
