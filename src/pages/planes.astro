<!-- =========================================================================
     SCRIPT INTERACTIVO PARA TOGGLE MENSUAL / ANUAL
     ========================================================================= -->
<script is:inline>
  function setupPlanesPageToggle() {
    const monthlyBtn = document.getElementById('planes-monthly-btn');
    const annualBtn = document.getElementById('planes-annual-btn');
    const monthlyPrices = document.querySelectorAll('.planes-price-monthly');
    const annualPrices = document.querySelectorAll('.planes-price-annual');
    const billingCycles = document.querySelectorAll('.planes-cycle-text');

    if (!monthlyBtn || !annualBtn) return;

    function setBilling(isAnnual) {
      if (isAnnual) {
        monthlyBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-gray-400 hover:text-white border border-transparent cursor-pointer';
        annualBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-white bg-sky-500/20 border border-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] cursor-pointer flex items-center gap-2';

        monthlyPrices.forEach((el) => el.classList.add('hidden'));
        annualPrices.forEach((el) => el.classList.remove('hidden'));
        billingCycles.forEach((el) => (el.textContent = 'USD / mes (anual)'));
      } else {
        annualBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-gray-400 hover:text-white border border-transparent cursor-pointer flex items-center gap-2';
        monthlyBtn.className = 'px-5 py-2 rounded-full text-xs font-semibold transition-all duration-300 text-white bg-sky-500/20 border border-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.25)] cursor-pointer';

        annualPrices.forEach((el) => el.classList.add('hidden'));
        monthlyPrices.forEach((el) => el.classList.remove('hidden'));
        billingCycles.forEach((el) => (el.textContent = 'USD / mes'));
      }
    }

    monthlyBtn.onclick = () => setBilling(false);
    annualBtn.onclick = () => setBilling(true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPlanesPageToggle);
  } else {
    setupPlanesPageToggle();
  }
  document.addEventListener('astro:page-load', setupPlanesPageToggle);
</script>

